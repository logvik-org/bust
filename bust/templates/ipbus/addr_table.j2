<?xml version="1.0" encoding="ISO-8859-1"?>
<node id="{{ module.name }}">
{# Software cannot reach a register or field without sw access, so uHAL gets no node for it. #}
{% for reg in module.registers if reg.sw.value != "na" %}
    <node id="{{ reg.name }}" address="0x{{ "%08X" | format(reg.address) }}" permission="{{ {'rw': 'rw', 'ro': 'r', 'wo': 'w'}[reg.sw.value] }}" description="{{ reg.description }}" parameters="reset={{ reg.reset }}{% if reg.mode.value == "pulse" %};pulse_cycles={{ reg.pulse_cycles }}{% endif %}{% if reg.stall %};stall_cycles={{ reg.stall_cycles }}{% endif %}"{% if reg.type != reg_type_fields %}/{% endif %}>
{% if reg.type == reg_type_fields %}
{% for field in reg.fields if field.sw.value != "na" %}
        <node id="{{ field.name }}" mask="{{ "0x%x" | format(field.mask) }}" description="{{ field.description }}" parameters="reset={{ field.reset }}"/>
{% endfor %}
    </node>
{% endif %}
{% endfor %}
</node>