<?xml version="1.0" encoding="UTF-8"?>
<node id="{{ module.name }}">
{# Software cannot reach a register or field without sw access, so uHAL gets no node for it. #}
{% set uhal_permission = {'rw': 'rw', 'ro': 'r', 'wo': 'w'} %}
{% for reg in module.registers if reg.sw.value != "na" %}
    <node id="{{ reg.name }}" address="0x{{ "%08X" | format(reg.address) }}" permission="{{ uhal_permission[reg.sw.value] }}" description="{{ reg.description | e }}" parameters="reset={{ reg.reset }}"{% if reg.type != reg_type_fields %}/{% endif %}>
{% if reg.type == reg_type_fields %}
{% for field in reg.fields if field.sw.value != "na" %}
        <node id="{{ field.name }}" mask="{{ "0x%x" | format(field.mask) }}" permission="{{ uhal_permission[field.sw.value] }}" description="{{ field.description | e }}" parameters="reset={{ field.reset }}"/>
{% endfor %}
    </node>
{% endif %}
{% endfor %}
</node>