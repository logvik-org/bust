{% macro field_notes(field) %}
{% set notes = [] %}
{% if field.description %}{% set _ = notes.append(field.description | markdown_cell) %}{% endif %}
{% if field.onread %}{% set _ = notes.append("onread: " ~ field.onread.value ~ ".") %}{% endif %}
{% if field.onwrite %}{% set _ = notes.append("onwrite: " ~ field.onwrite.value ~ ".") %}{% endif %}
{% if field.singlepulse %}{% set _ = notes.append("singlepulse.") %}{% endif %}
{% set modifiers = [] %}
{% for name in ["we", "wel", "hwset", "hwclr", "swmod", "swacc"] if field[name] %}{% set _ = modifiers.append(name) %}{% endfor %}
{% if modifiers %}{% set _ = notes.append("Modifiers: " ~ modifiers | join(", ") ~ ".") %}{% endif %}
{% if field.is_enum %}
{% set values = [] %}
{% for e in field.enums %}{% set _ = values.append(e.name ~ "=" ~ e.value) %}{% endfor %}
{% set _ = notes.append("Values: " ~ values | join(", ") ~ ".") %}
{% endif %}
{{ notes | join(" ") }}
