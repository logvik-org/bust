<!DOCTYPE html>
<!-- Generated by bust v{{ version }} {{ generated_at() }} -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ module.name | e }}</title>
<style>
:root { --ink: #1a1a1a; --muted: #5c5c5c; --rule: #9a9a9a; --unused: #ececec; --link: #1f4e9c; }
* { box-sizing: border-box; }
body { margin: 0; color: var(--ink); background: #fff; font: 15px/1.5 "Latin Modern Roman", "Computer Modern Serif", Georgia, serif; }
code, .mono { font-family: "Latin Modern Mono", Menlo, Consolas, monospace; font-size: 0.92em; }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
nav { position: fixed; top: 0; bottom: 0; left: 0; width: 13rem; overflow-y: auto; padding: 1.5rem 1rem; border-right: 1px solid var(--rule); font-size: 0.9rem; }
nav h2 { font-size: 0.95rem; margin: 0 0 0.5rem; }
nav ol { list-style: none; margin: 0; padding: 0; }
nav li { margin: 0.15rem 0; }
main { margin-left: 13rem; padding: 1.5rem 2.5rem 4rem; max-width: 62rem; }
.running { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.85rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.3rem; }
header.title { text-align: center; margin: 2.5rem 0 2rem; }
header.title h1 { font-size: 2rem; font-weight: normal; margin: 0 0 0.8rem; }
header.title p { margin: 0.2rem 0; }
h2 { font-size: 1.4rem; margin: 2rem 0 1rem; }
table.list { width: 100%; border-collapse: collapse; }
table.list th, table.list td { border: 1px solid var(--ink); padding: 0.15rem 0.5rem; text-align: left; }
table.list td.num { text-align: center; }
section.register { margin: 0 0 2.5rem; break-inside: avoid; }
section.register h3 { display: flex; justify-content: space-between; font-size: 1.05rem; margin: 0 0 0.4rem; }
.diagram { overflow-x: auto; margin: 0.6rem 0; }
svg.bits { width: 100%; height: auto; }
svg.bits rect.field { fill: #fff; stroke: var(--ink); }
svg.bits rect.unused { fill: var(--unused); stroke: var(--ink); }
svg.bits text { fill: var(--ink); font-family: inherit; }
svg.bits .name { font-size: 11px; }
svg.bits .num, svg.bits .reset { font-size: 10px; }
svg.bits .reset { fill: var(--muted); }
dl.fields { margin: 0.5rem 0 0 1.5rem; }
dl.fields dt { font-weight: bold; float: left; clear: left; margin-right: 0.6rem; }
dl.fields dd { margin: 0 0 0.3rem; }
.back { font-size: 0.85rem; }
@media (max-width: 50rem) {
  nav { position: static; width: auto; border-right: none; border-bottom: 1px solid var(--rule); }
  main { margin-left: 0; padding: 1rem; }
}
@media print {
  nav, .back { display: none; }
  main { margin: 0; padding: 0; max-width: none; }
  body { font-size: 11pt; }
  a { color: inherit; }
  header.title { margin-top: 0; }
  h2 { break-after: avoid; }
}
</style>
</head>
<body>
<nav>
<h2><a href="#register-list">Registers</a></h2>
<ol>
{% for reg in module.registers %}
<li><a href="#{{ reg.name | e }}">{{ reg.name | e }}</a></li>
{% endfor %}
</ol>
</nav>
<main>
<div class="running"><span>Generated by bust v{{ version }}</span>{% if module.version %}<span>Version: {{ module.version | e }}</span>{% endif %}</div>
<header class="title">
<h1>{{ module.name | e }}</h1>
{% if module.version %}
<p>Version: {{ module.version | e }}</p>
{% endif %}
<p>Register map hash: <span class="mono">0x{{ module.regmap_hash_hex }}</span></p>
<p>{{ generated_at() }}</p>
</header>
{% if module.description %}
<p>{{ module.description | utf8tohtml }}</p>
{% endif %}

<h2 id="register-list">1 Register List</h2>
<table class="list">
<thead>
<tr>{% for header in list_headers %}<th>{{ header | e }}</th>{% endfor %}</tr>
</thead>
<tbody>
{% for row, reg in list_rows %}
<tr><td>{{ row[0] }}</td><td><a href="#{{ reg.name | e }}">{{ row[1] | e }}</a></td><td>{{ row[2] }}</td><td class="mono">{{ row[3] }}</td><td>{{ row[4] }}</td><td class="num">{{ row[5] }}</td><td class="mono">{{ row[6] }}</td></tr>
{% endfor %}
</tbody>
</table>

<h2>2 Registers</h2>
{% for reg in module.registers %}
{% set title, address = register_heading(reg) %}
<section class="register" id="{{ reg.name | e }}">
<h3><span>{{ title | e }}</span><span class="mono">{{ address }}</span></h3>
{% if reg.description %}
<p>{{ reg.description | utf8tohtml }}</p>
{% endif %}
<div class="diagram">{{ bit_diagram_svg(reg, module.data_width) }}</div>
{% if reg.type == reg_type_fields %}
<dl class="fields">
{% for name, note in field_notes(reg) %}
<dt>{{ name | e }}</dt><dd>{{ note | utf8tohtml }}</dd>
{% endfor %}
</dl>
{% endif %}
<p class="back"><a href="#register-list">Back to the register list</a></p>
</section>
{% endfor %}
</main>
</body>
</html>
