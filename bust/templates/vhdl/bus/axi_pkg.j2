library ieee;
use ieee.std_logic_1164.all;

package {{ bus_type }}_pkg is


  constant C_{{ bus_type.upper() }}_DATA_WIDTH : natural := {{ data_width }};
  constant C_{{ bus_type.upper() }}_ADDR_WIDTH : natural := {{ addr_width }};

  subtype t_{{ bus_type }}_data is std_logic_vector(C_{{ bus_type.upper() }}_DATA_WIDTH-1 downto 0);
  subtype t_{{ bus_type }}_addr is std_logic_vector(C_{{ bus_type.upper() }}_ADDR_WIDTH-1 downto 0);

  type t_{{ bus_type }}_mosi is record
    araddr  : t_{{ bus_type }}_addr;
    arvalid : std_logic;
    awaddr  : t_{{ bus_type }}_addr;
    awvalid : std_logic;
    bready  : std_logic;
    rready  : std_logic;
    wdata   : t_{{ bus_type }}_data;
    wvalid  : std_logic;
  end record;

  type t_{{ bus_type }}_miso is record
    arready : std_logic;
    awready : std_logic;
    bresp   : std_logic_vector(1 downto 0);
    bvalid  : std_logic;
    rdata   : t_{{ bus_type }}_data;
    rresp   : std_logic_vector(1 downto 0);
    rvalid  : std_logic;
    wready  : std_logic;
  end record;

end {{ bus_type }}_pkg;
