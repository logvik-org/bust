{% macro member_type(field, member) -%}
{%- if member == 'value' -%}{{ field.value_type_vhdl }}{%- else -%}std_logic{%- endif -%}
{%- endmacro -%}
{% macro fhw_reset(f) -%}
{%- if f.from_hw_is_record -%}({% for m in f.from_hw_members %}{{ m }} => {{ f.reset_value_vhdl if m == 'value' else ("'1'" if m == 'wel' else "'0'") }}{% if not loop.last %}, {% endif %}{% endfor %}){%- else -%}{{ f.reset_value_vhdl }}{%- endif -%}
{%- endmacro -%}
-- Register definitions for the {{ module.name }} module.
--
-- Generated by bust. Registers and fields are expressed as nested records
-- (regs.<reg>.<field>) so the module stays one record signal and the hardware
-- sees each field by name with its modifiers attached.
--
-- Three record families, all nested register -> field:
--   t_{{ module.name }}_regs      internal storage (one per field that holds state)
--   t_{{ module.name }}_to_hw     regfile -> hardware (hw r / rw field values)
--   t_{{ module.name }}_from_hw   hardware -> regfile (hw w / rw values + modifiers)
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.{{ module.name }}_localbus_pkg.all;

package {{ module.name }}_regfile_pkg is

{% for reg in module.registers %}
  constant C_ADDR_{{ reg.name | upper }} : std_logic_vector({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"{{ "%02X" | format(reg.address) }}";
{% endfor %}

  -- Register-select width: the low address bits that pick a register. It is the
  -- smallest module address width that holds the registers, and the default of
  -- the G_MODULE_ADDR_WIDTH generic.
  constant C_MODULE_ADDR_WIDTH : natural := {{ module.register_select_width }};
{% for f in module.enum_fields %}

  -- Enumerated field type for {{ f.parent_register_name }}.{{ f.name }}. The
  -- conversion functions map each literal to and from its encoded value.
  type {{ f.enum_type_name }} is ({{ f.enums | map(attribute='name') | join(', ') }});
  function to_slv(v : {{ f.enum_type_name }}) return std_logic_vector;
  function to_{{ f.parent_register_name }}_{{ f.name }}(s : std_logic_vector({{ f.vector_range_vhdl }})) return {{ f.enum_type_name }};
{% endfor %}

  -- Internal storage, one record per register, each member a field that holds
  -- state (every software- or hardware-writable field).
{% for reg in module.stored_registers %}
  type t_{{ reg.name }}_regs is record
{% for f in reg.stored_fields %}
    {{ f.name }} : {{ f.value_type_vhdl }};
{% endfor %}
  end record;
{% endfor %}
{% if module.stored_registers %}

  -- Whole-module storage: the regfile keeps this as a single signal.
  type t_{{ module.name }}_regs is record
{% for reg in module.stored_registers %}
    {{ reg.name }} : t_{{ reg.name }}_regs;
{% endfor %}
  end record;

  constant C_{{ module.name | upper }}_REGS_RESET : t_{{ module.name }}_regs := (
{% for reg in module.stored_registers %}
    {{ reg.name }} => ({% for f in reg.stored_fields %}{{ f.name }} => {{ f.reset_value_vhdl }}{% if not loop.last %}, {% endif %}{% endfor %}){% if not loop.last %},{% else %});{% endif %}

{% endfor %}
{% endif %}

  -- regfile -> hardware: only fields the hardware can read (hw r / rw). Fields
  -- with a software-access pulse (swmod/swacc) pair the value with the strobe.
  -- A register without fields gets no t_<reg>_to_hw record. Its member of
  -- t_<module>_to_hw is its value, or a record of the value and the strobe
  -- when it has swmod or swacc.
{% for reg in module.to_hw_registers %}
{% for f in reg.to_hw_fields if f.to_hw_is_record %}
  type {{ f.to_hw_record_name }} is record
{% for m in f.to_hw_members %}
    {{ m }} : {{ member_type(f, m) }};
{% endfor %}
  end record;

{% endfor %}
{% if reg.fields %}
  type t_{{ reg.name }}_to_hw is record
{% for f in reg.to_hw_fields %}
    {{ f.name }} : {{ f.to_hw_record_name if f.to_hw_is_record else f.value_type_vhdl }};
{% endfor %}
  end record;
{% endif %}
{% endfor %}

{% if module.to_hw_registers %}
  -- Whole-module regfile -> hardware bundle.
  type t_{{ module.name }}_to_hw is record
{% for reg in module.to_hw_registers %}
    {{ reg.name }} : {{ reg.to_hw_type_name }};
{% endfor %}
  end record;
{% endif %}

  -- hardware -> regfile: per-field input records pairing each value with the
  -- modifier strobes that gate it. A field gets its own record only when it
  -- carries a strobe (we/wel/set/clr); a plain continuous input is a bare member.
{% for reg in module.from_hw_registers %}
{% for f in reg.from_hw_fields if f.from_hw_is_record %}
  type {{ f.from_hw_record_name }} is record
{% for m in f.from_hw_members %}
    {{ m }} : {{ member_type(f, m) }};
{% endfor %}
  end record;

{% endfor %}
{% if reg.fields %}
  type t_{{ reg.name }}_from_hw is record
{% for f in reg.from_hw_fields %}
    {{ f.name }} : {{ f.from_hw_record_name if f.from_hw_is_record else f.value_type_vhdl }};
{% endfor %}
  end record;
{% endif %}
{% endfor %}

{% if module.from_hw_registers %}
  -- Whole-module hardware -> regfile bundle.
  type t_{{ module.name }}_from_hw is record
{% for reg in module.from_hw_registers %}
    {{ reg.name }} : {{ reg.from_hw_type_name }};
{% endfor %}
  end record;

  -- from_hw at rest: every value at its reset, every strobe inactive.
  constant C_{{ module.name | upper }}_FROM_HW_RESET : t_{{ module.name }}_from_hw := (
{% for reg in module.from_hw_registers %}
    {{ reg.name }} => {% if reg.fields %}({% for f in reg.from_hw_fields %}{{ f.name }} => {{ fhw_reset(f) }}{% if not loop.last %}, {% endif %}{% endfor %}){% else %}{{ fhw_reset(reg.from_hw_fields[0]) }}{% endif %}{% if not loop.last %},{% else %});{% endif %}

{% endfor %}
{% endif %}

  -- base_match and above_registers get the register file's G_MODULE_ADDR_WIDTH
  -- as module_addr_width. In an address, bits 0 to C_MODULE_ADDR_WIDTH - 1
  -- select a register, bits C_MODULE_ADDR_WIDTH to module_addr_width - 1 must
  -- be 0, and bit module_addr_width and up are the base address.

  -- True when check is false, or when the base address bits of addr equal the
  -- same bits of base.
  function base_match(addr              : std_logic_vector({{ module.addr_width - 1 }} downto 0);
                      base              : unsigned({{ module.addr_width - 1 }} downto 0);
                      check             : boolean;
                      module_addr_width : natural) return boolean;

  -- True when any of bits C_MODULE_ADDR_WIDTH to module_addr_width - 1 of addr
  -- is set. The address is then in the module's address range but above the
  -- registers, and the register file answers it with an error, so that it
  -- cannot reach a register through its low bits.
  function above_registers(addr              : std_logic_vector({{ module.addr_width - 1 }} downto 0);
                           module_addr_width : natural) return boolean;

  -- True when reg_offset, the low address bits of an access, equals the
  -- register offset in reg_addr. Every bit counts, so an address between two
  -- registers, or inside one, matches no register.
  function reg_addr_match(reg_offset : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0);
                          reg_addr   : std_logic_vector({{ module.addr_width - 1 }} downto 0)) return boolean;

  -- True when a register sits at reg_offset.
  function is_mapped(reg_offset : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0)) return boolean;

end package {{ module.name }}_regfile_pkg;

package body {{ module.name }}_regfile_pkg is

  function base_match(addr              : std_logic_vector({{ module.addr_width - 1 }} downto 0);
                      base              : unsigned({{ module.addr_width - 1 }} downto 0);
                      check             : boolean;
                      module_addr_width : natural) return boolean is
    constant base_slv : std_logic_vector({{ module.addr_width - 1 }} downto 0) := std_logic_vector(base);
  begin
    if not check then
      return true;
    end if;
    return addr({{ module.addr_width - 1 }} downto module_addr_width)
         = base_slv({{ module.addr_width - 1 }} downto module_addr_width);
  end function;

  function above_registers(addr              : std_logic_vector({{ module.addr_width - 1 }} downto 0);
                           module_addr_width : natural) return boolean is
  begin
    for i in C_MODULE_ADDR_WIDTH to module_addr_width - 1 loop
      if addr(i) /= '0' then
        return true;
      end if;
    end loop;
    return false;
  end function;

  function reg_addr_match(reg_offset : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0);
                          reg_addr   : std_logic_vector({{ module.addr_width - 1 }} downto 0)) return boolean is
  begin
    return reg_offset = reg_addr(C_MODULE_ADDR_WIDTH-1 downto 0);
  end function;

  function is_mapped(reg_offset : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0)) return boolean is
  begin
    return {% if module.registers %}{% for reg in module.registers %}reg_addr_match(reg_offset, C_ADDR_{{ reg.name | upper }}){% if not loop.last %} or {% endif %}{% endfor %}{% else %}false{% endif %};
  end function;
{% for f in module.enum_fields %}

  -- case over the literals so the encoding follows each enum's declared value,
  -- not its position; the two only coincide for in-order 0,1,2,.. enums.
  function to_slv(v : {{ f.enum_type_name }}) return std_logic_vector is
    variable slv : std_logic_vector({{ f.vector_range_vhdl }});
  begin
    case v is
{% for e in f.enums %}
      when {{ e.name }} => slv := "{{ e.value | to_binary(f.width) }}";
{% endfor %}
    end case;
    return slv;
  end function;

  -- case decode rather than to_integer(unsigned(s)) so meta-values (X/U/Z/-)
  -- give a defined result instead of a numeric_std assertion.
  function to_{{ f.parent_register_name }}_{{ f.name }}(s : std_logic_vector({{ f.vector_range_vhdl }})) return {{ f.enum_type_name }} is
  begin
    case s is
{% for e in f.enums %}
      when "{{ e.value | to_binary(f.width) }}" => return {{ e.name }};
{% endfor %}
      when others => return {{ f.enums[0].name }};
    end case;
  end function;
{% endfor %}

end package body {{ module.name }}_regfile_pkg;
