-- SBI (Simple Bus Interface) wrapper for the {{ module.name }} local-bus register file.
--   SBI -> local bus (t_lb_m2s / t_lb_s2m) -> regfile
--
-- Generated by bust. SBI is a single-beat protocol with an explicit ready
-- handshake: the master raises cs together with wena or rena and holds the
-- request until the slave asserts ready. The bridge is pure combinational glue:
-- the request drives one local-bus transaction and the regfile's response is
-- forwarded straight back as a one-cycle ready beat. No FSM and no register stage
-- of its own: the regfile's single registered cycle is the whole latency, and its
-- response guard provides transaction separation. ack and err alike complete as
-- one ready beat (SBI has no error line); on a decode error rdata is forced to 0
-- so reads of invalid addresses stay deterministic. SBI carries no reset of its
-- own, so a sync active-high reset passes straight to the regfile. The master
-- drives a byte address, mapped directly onto the local bus.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_sbi_endpoint is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true
  );
  port (
    clk     : in  std_logic;
    reset   : in  std_logic;

    -- SBI subordinate interface
    cs      : in  std_logic;
    addr    : in  std_logic_vector({{ module.addr_width - 1 }} downto 0);
    rena    : in  std_logic;
    wena    : in  std_logic;
    wdata   : in  std_logic_vector({{ module.data_width - 1 }} downto 0);
    ready   : out std_logic;
    rdata   : out std_logic_vector({{ module.data_width - 1 }} downto 0){% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}
    to_hw   : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_sbi_endpoint;

architecture rtl of {{ module.name }}_sbi_endpoint is

  signal m2s : t_lb_m2s;
  signal s2m : t_lb_s2m;

begin

  i_regfile : entity work.{{ module.name }}_regfile
    generic map (
      G_BASE_ADDRESS       => G_BASE_ADDRESS,
      G_CHECK_BASE_ADDRESS => G_CHECK_BASE_ADDRESS,
      G_RESET_ACTIVE_LOW   => false)      -- SBI carries no reset; use sync active-high
    port map (
      clk     => clk,
      reset   => reset,
      lb_m2s  => m2s,
      lb_s2m  => s2m{% if module.to_hw_registers %},
      to_hw   => to_hw{% endif %}{% if module.from_hw_registers %},
      from_hw => from_hw{% endif %});

  m2s.address <= addr;
  m2s.wdata   <= wdata;
  m2s.wen     <= cs and wena;
  m2s.ren     <= cs and rena;

  -- SBI has no error line, so ack and err both complete as a single ready beat;
  -- on a decode error rdata is forced to 0 (the regfile leaves it unchanged).
  ready <= s2m.ack or s2m.err;
  rdata <= (others => '0') when s2m.err = '1' else s2m.rdata;

end architecture rtl;
