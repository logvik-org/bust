{#-
  Generate the p_stall process for IPBus read/write stall handling.

  Parameters:
    module:       The module object
    clk_name:     Clock signal name
    reset_name:   Reset signal name
    reset_active_high: Boolean
    addr_width:   Integer width used in register address comparison
    short_name:   Prefix for register signal naming (e.g., "ipb")

  Assumes that module.has_stall_regs() is True
-#}
{% macro pif_stall(module, clk_name, reset_name, reset_active_high, addr_width, short_name) %}
p_stall : process({{ clk_name }})
  variable v_cnt : natural := 0;
begin
  if rising_edge({{ clk_name }}) then
    {% if reset_active_high %}
    if {{ reset_name }} = '1' then
    {% else %}
    if {{ reset_name }} = '0' then
    {% endif %}
      stall <= '0';
    else
      ack_d <= '0';
      if wr_stall_ack or rd_stall_ack then
        stall <= '1';
        {% for reg in module.registers if reg.stall %}
        if unsigned({{ short_name }}_in.{{ short_name }}_addr) = resize(unsigned(C_BASEADDR) + unsigned(C_ADDR_{{ reg.name | upper }}), {{ addr_width }}) then
          v_cnt := {{ reg.get_stall_cycles_str() }};
        end if;
        {% endfor %}
      elsif v_cnt > 0 then
        v_cnt := v_cnt - 1;
        stall <= '1';
      elsif stall then
        stall <= '0';
        ack_d <= '1';
      end if;
    end if;
  end if;
end process p_stall;
{% endmacro %}