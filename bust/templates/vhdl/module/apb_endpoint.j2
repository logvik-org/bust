-- APB (AMBA APB) wrapper for the {{ module.name }} local-bus register file.
--   APB -> local bus (t_lb_m2s / t_lb_s2m) -> regfile
--
-- Generated by bust. APB is a two-phase protocol: a SETUP cycle (psel asserted,
-- penable low) is followed by ACCESS cycles (psel and penable both high) until the
-- slave raises pready. The bridge drives the local-bus request from the SETUP cycle
-- itself and holds it (busy) until the regfile answers, so the regfile's single
-- registered cycle surfaces as pready in the first ACCESS cycle: a zero-wait-state
-- transfer (the APB two-cycle minimum). The response (pready/prdata/pslverr) is
-- forwarded combinationally from the local bus, adding no register stage of its own.
-- Holding the request until ack honours the local-bus hold-until-ack contract, so a
-- variable-latency register simply stretches the ACCESS phase with wait states. The
-- busy flag keeps the request asserted for exactly one transaction (the regfile's
-- own response guard blocks a re-service in the ack cycle), and it clears on ack so a
-- back-to-back transfer starts cleanly at its SETUP cycle. APB has a native pslverr,
-- so a regfile decode error maps to pslverr (prdata still forced to 0). APB's reset
-- (presetn) is active-low and async, handed to the regfile via G_RESET_ACTIVE_LOW;
-- the master drives a byte address mapped directly onto the local bus.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.{{ module.name }}_localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_apb_endpoint is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true;
    G_MODULE_ADDR_WIDTH  : natural := C_MODULE_ADDR_WIDTH
  );
  port (
    pclk    : in  std_logic;
    presetn : in  std_logic;

    -- APB subordinate interface
    psel    : in  std_logic;
    penable : in  std_logic;
    pwrite  : in  std_logic;
    paddr   : in  std_logic_vector({{ module.addr_width - 1 }} downto 0);
    pwdata  : in  std_logic_vector({{ module.data_width - 1 }} downto 0);
    prdata  : out std_logic_vector({{ module.data_width - 1 }} downto 0);
    pready  : out std_logic;
    pslverr : out std_logic{% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}
    to_hw   : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_apb_endpoint;

architecture rtl of {{ module.name }}_apb_endpoint is

  signal m2s : t_lb_m2s;
  signal s2m : t_lb_s2m;

  -- Request held from the SETUP cycle until the regfile answers, so the local-bus
  -- hold-until-ack contract holds even for a variable-latency register.
  signal busy       : std_logic := '0';
  signal req_active : std_logic;

begin

  i_regfile : entity work.{{ module.name }}_regfile
    generic map (
      G_BASE_ADDRESS       => G_BASE_ADDRESS,
      G_CHECK_BASE_ADDRESS => G_CHECK_BASE_ADDRESS,
      G_MODULE_ADDR_WIDTH  => G_MODULE_ADDR_WIDTH,
      G_RESET_ACTIVE_LOW   => true)       -- APB presetn is active-low
    port map (
      clk     => pclk,
      reset   => presetn,
      lb_m2s  => m2s,
      lb_s2m  => s2m{% if module.to_hw_registers %},
      to_hw   => to_hw{% endif %}{% if module.from_hw_registers %},
      from_hw => from_hw{% endif %});

  -- Active from the SETUP cycle (psel high, penable low) and held while busy.
  req_active <= '1' when (psel = '1' and penable = '0') or busy = '1' else '0';

  m2s.address <= paddr;
  m2s.wdata   <= pwdata;
  m2s.wen     <= req_active and pwrite;
  m2s.ren     <= req_active and not pwrite;

  p_busy : process (pclk, presetn) is
  begin
    if presetn = '0' then
      busy <= '0';
    elsif rising_edge(pclk) then
      if psel = '1' and penable = '0' then
        busy <= '1';                      -- latch the in-flight transaction at SETUP
      elsif s2m.ack = '1' or s2m.err = '1' then
        busy <= '0';                      -- release once the regfile answers
      end if;
    end if;
  end process p_busy;

  pready  <= s2m.ack or s2m.err;
  pslverr <= s2m.err;
  prdata  <= (others => '0') when s2m.err = '1' else s2m.rdata;

end architecture rtl;
