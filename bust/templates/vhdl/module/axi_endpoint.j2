-- AXI4-Lite wrapper for the {{ module.name }} local-bus register file.
--   AXI4-Lite -> local bus (t_lb_m2s / t_lb_s2m) -> regfile
--
-- Generated by bust. The wrapper adds no latency on top of the regfile: a
-- transaction is accepted (AW+W or AR) and driven onto the local bus in the same
-- cycle, and the regfile's response is presented combinationally on the cycle it
-- acks. The response is latched into a hold register only when BREADY/RREADY is
-- low on the ack cycle (back-pressure, not added latency), and the request is
-- held (addr_q/wdata_q) until ack so the local-bus hold-until-ack contract holds
-- across wait states. err maps to SLVERR, ack to OKAY; AXI's async active-low
-- reset is handed to the regfile via G_RESET_ACTIVE_LOW.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.{{ module.name }}_localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_axi_endpoint is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true;
    G_MODULE_ADDR_WIDTH  : natural := C_MODULE_ADDR_WIDTH
  );
  port (
    clk      : in  std_logic;
    areset_n : in  std_logic;

    -- AXI4-Lite subordinate interface
    awaddr   : in  std_logic_vector({{ module.addr_width - 1 }} downto 0);
    awvalid  : in  std_logic;
    awready  : out std_logic;
    wdata    : in  std_logic_vector({{ module.data_width - 1 }} downto 0);
    wvalid   : in  std_logic;
    wready   : out std_logic;
    bresp    : out std_logic_vector(1 downto 0);
    bvalid   : out std_logic;
    bready   : in  std_logic;
    araddr   : in  std_logic_vector({{ module.addr_width - 1 }} downto 0);
    arvalid  : in  std_logic;
    arready  : out std_logic;
    rdata    : out std_logic_vector({{ module.data_width - 1 }} downto 0);
    rresp    : out std_logic_vector(1 downto 0);
    rvalid   : out std_logic;
    rready   : in  std_logic{% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}

    -- hardware side of the register file
    to_hw    : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw  : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_axi_endpoint;

architecture rtl of {{ module.name }}_axi_endpoint is

  -- AXI responses: OKAY / SLVERR.
  constant C_RESP_OKAY   : std_logic_vector(1 downto 0) := "00";
  constant C_RESP_SLVERR : std_logic_vector(1 downto 0) := "10";

  type t_state is (ST_IDLE, ST_WRITE, ST_BHOLD, ST_READ, ST_RHOLD);
  signal state : t_state := ST_IDLE;

  signal m2s : t_lb_m2s;
  signal s2m : t_lb_s2m;

  -- Held request (hold-until-ack across wait states) and held response (for AXI
  -- back-pressure when the master is not ready on the ack cycle).
  signal addr_q  : std_logic_vector({{ module.addr_width - 1 }} downto 0) := (others => '0');
  signal wdata_q : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal rdata_q : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal rresp_q : std_logic_vector(1 downto 0)  := C_RESP_OKAY;
  signal bresp_q : std_logic_vector(1 downto 0)  := C_RESP_OKAY;

  signal start_wr : std_logic;
  signal start_rd : std_logic;
  signal resp     : std_logic;          -- regfile answered this cycle (ack or err)

begin

  i_regfile : entity work.{{ module.name }}_regfile
    generic map (
      G_BASE_ADDRESS       => G_BASE_ADDRESS,
      G_CHECK_BASE_ADDRESS => G_CHECK_BASE_ADDRESS,
      G_MODULE_ADDR_WIDTH  => G_MODULE_ADDR_WIDTH,
      G_RESET_ACTIVE_LOW   => true)       -- AXI reset is active-low
    port map (
      clk     => clk,
      reset   => areset_n,
      lb_m2s  => m2s,
      lb_s2m  => s2m{% if module.to_hw_registers %},
      to_hw   => to_hw{% endif %}{% if module.from_hw_registers %},
      from_hw => from_hw{% endif %});

  -- Accept in IDLE, write has priority; exactly one of wen/ren is ever driven.
  start_wr <= '1' when state = ST_IDLE and awvalid = '1' and wvalid = '1' else '0';
  start_rd <= '1' when state = ST_IDLE and arvalid = '1'
                       and not (awvalid = '1' and wvalid = '1') else '0';

  resp <= s2m.ack or s2m.err;

  -- Drive the local bus in the accept cycle and hold it (held address/data) until
  -- the regfile answers.
  m2s.wen     <= '1' when start_wr = '1' or state = ST_WRITE else '0';
  m2s.ren     <= '1' when start_rd = '1' or state = ST_READ else '0';
  m2s.address <= awaddr when start_wr = '1' else
                 araddr when start_rd = '1' else
                 addr_q;
  m2s.wdata   <= wdata when start_wr = '1' else wdata_q;

  -- Accept strobes are single-cycle, asserted only on the accept cycle.
  awready <= start_wr;
  wready  <= start_wr;
  arready <= start_rd;

  -- Write response: combinational on the ack cycle, held while back-pressured.
  bvalid <= '1' when (state = ST_WRITE and resp = '1') or state = ST_BHOLD else '0';
  bresp  <= bresp_q       when state = ST_BHOLD else
            C_RESP_SLVERR when s2m.err = '1'    else
            C_RESP_OKAY;

  -- Read response: combinational on the ack cycle, held while back-pressured.
  rvalid <= '1' when (state = ST_READ and resp = '1') or state = ST_RHOLD else '0';
  rresp  <= rresp_q       when state = ST_RHOLD else
            C_RESP_SLVERR when s2m.err = '1'    else
            C_RESP_OKAY;
  rdata  <= rdata_q         when state = ST_RHOLD else
            (others => '0') when s2m.err = '1'    else
            s2m.rdata;

  p_axi : process (clk, areset_n) is
  begin
    if areset_n = '0' then
      state   <= ST_IDLE;
      addr_q  <= (others => '0');
      wdata_q <= (others => '0');
      rdata_q <= (others => '0');
      rresp_q <= C_RESP_OKAY;
      bresp_q <= C_RESP_OKAY;
    elsif rising_edge(clk) then
      case state is
        when ST_IDLE =>
          if start_wr = '1' then
            addr_q  <= awaddr;
            wdata_q <= wdata;
            state   <= ST_WRITE;
          elsif start_rd = '1' then
            addr_q <= araddr;
            state  <= ST_READ;
          end if;

        when ST_WRITE =>
          if resp = '1' then
            if bready = '1' then          -- response accepted same cycle
              state <= ST_IDLE;
            else                          -- hold B until the master is ready
              bresp_q <= C_RESP_SLVERR when s2m.err = '1' else C_RESP_OKAY;
              state   <= ST_BHOLD;
            end if;
          end if;

        when ST_BHOLD =>
          if bready = '1' then
            state <= ST_IDLE;
          end if;

        when ST_READ =>
          if resp = '1' then
            if rready = '1' then          -- response accepted same cycle
              state <= ST_IDLE;
            else                          -- hold R until the master is ready
              rdata_q <= (others => '0') when s2m.err = '1' else s2m.rdata;
              rresp_q <= C_RESP_SLVERR when s2m.err = '1' else C_RESP_OKAY;
              state   <= ST_RHOLD;
            end if;
          end if;

        when ST_RHOLD =>
          if rready = '1' then
            state <= ST_IDLE;
          end if;
      end case;
    end if;
  end process p_axi;

end architecture rtl;
