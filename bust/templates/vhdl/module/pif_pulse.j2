{#
  Template for generating a VHDL process for a pulse-mode register.

  Parameters:
    clk_name            : Clock signal name
    reset_name          : Reset signal name
    proc_name           : Name of the VHDL process
    const_name          : Constant default value name (e.g. c_module_pulse_regs.reg)
    reg_name            : Signal assignment target (e.g. short_pulse_regs_i.reg)
    reg_tmp_name        : Intermediate signal (e.g. short_pulse_regs_cycle.reg)
    pulse_cycles        : Number of pulse cycles
    reset_active_high   : Whether reset is active high (true/false)
    indent_all          : Custom filter that indents multiline blocks
#}
{% macro pif_pulse(clk_name, reset_name, proc_name, const_name, reg_name, reg_tmp_name, pulse_cycles, reset_active_high) %}
{% set has_counter = pulse_cycles > 1 %}
{{ proc_name }} : process({{ clk_name }})
{% if has_counter %}
  variable cnt : natural range 0 to {{ pulse_cycles - 1 }} := 0;
{% endif %}
begin
  if rising_edge({{ clk_name }}) then
    if {{ reset_name }} = '{{ '1' if reset_active_high else '0' }}' then
      {{ reg_name }} <= {{ const_name }};
    else
      if {{ reg_tmp_name }} /= {{ const_name }} then
{% if has_counter %}
        cnt := {{ pulse_cycles - 1 }};
{% endif %}
        {{ reg_name }} <= {{ reg_tmp_name }};
      else
{% if has_counter %}
        if cnt > 0 then
          cnt := cnt - 1;
        else
          {{ reg_name }} <= {{ const_name }};
        end if;
{% else %}
        {{ reg_name }} <= {{ const_name }};
{% endif %}
      end if;
    end if;
  end if;
end process {{ proc_name }};
{% endmacro %}