-- Protocol-agnostic local bus interface for register-map access.
--
-- Generated by bust. A minimal single-beat transaction: address, write data,
-- read data, write enable, read enable, plus an acknowledge / error response.
-- All supported bus protocols (AXI4-Lite, IPBus, ...) are thin wrappers around
-- this; the endpoint bridges the protocol to these records and the regfile
-- speaks only this interface.
--
-- Contract (single outstanding transaction, "hold until acknowledged"):
--   * The master asserts exactly one of wen / ren together with a valid
--     address (and wdata for writes) and holds the request stable until it
--     observes a response.
--   * The regfile completes the beat by pulsing exactly one of ack or err for
--     one clock cycle. ack and err are mutually exclusive.
--   * Variable-latency targets assert the response later; withholding ack/err
--     is the stall mechanism (covers IPBus stall and AXI back-pressure without
--     leaking protocol detail into the regfile).
library ieee;
use ieee.std_logic_1164.all;

package {{ module.name }}_localbus_pkg is

  constant C_LB_ADDR_WIDTH : natural := {{ module.addr_width }};
  constant C_LB_DATA_WIDTH : natural := {{ module.data_width }};

  type t_lb_m2s is record
    address : std_logic_vector(C_LB_ADDR_WIDTH - 1 downto 0);
    wdata   : std_logic_vector(C_LB_DATA_WIDTH - 1 downto 0);
    wen     : std_logic;
    ren     : std_logic;
  end record;

  type t_lb_s2m is record
    rdata : std_logic_vector(C_LB_DATA_WIDTH - 1 downto 0);
    ack   : std_logic;
    err   : std_logic;
  end record;

  constant C_LB_M2S_IDLE : t_lb_m2s := (
    address => (others => '0'),
    wdata   => (others => '0'),
    wen     => '0',
    ren     => '0');

  constant C_LB_S2M_IDLE : t_lb_s2m := (
    rdata => (others => '0'),
    ack   => '0',
    err   => '0');

end package {{ module.name }}_localbus_pkg;
