{#
  Parameters:
    reg:           reg object
    wdata:         string representing write data signal (e.g., "ipb_in.ipb_wdata" or "wdata")
    register_sel:   string like "register_sel" or "register_sel_wr"
    use_ack:       boolean; if true, generate wr_ack/wr_stall_ack
#}

{% macro statement_write_reg(reg, internal_signal_name, out_signal_name, register_sel, use_ack) %}
elsif unsigned({{ register_sel }}) = resize(unsigned(C_ADDR_{{ reg.name.upper() }}), C_MODULE_ADDR_WIDTH) then

    {% if reg.type == "fields" %}
      {% for field in reg.fields %}
  {{ internal_signal_name }}{{ reg.name }}.{{ field.name }} <= {{ out_signal_name }}({{ field.get_pos_vhdl() }});
      {% endfor %}
    {% elif reg.type == "default" %}
  {{ internal_signal_name }}{{ reg.name }} <= {{ out_signal_name }};
    {% elif reg.type == "slv" %}
  {{ internal_signal_name }}{{ reg.name }} <= {{ out_signal_name }}({{ reg.width - 1 }} downto 0);
    {% elif reg.type == "sl" %}
  {{ internal_signal_name }}{{ reg.name }} <= {{ out_signal_name }}(0);
    {% endif %}
    {% if use_ack %}
      {% if reg.stall %}
  wr_stall_ack <= '1';

      {% else %}
  wr_ack <= '1';

{% endif %}
{% else %}

{% endif %}
{% endmacro %}