-- Wishbone (B4 classic) wrapper for the {{ module.name }} local-bus register file.
--   Wishbone -> local bus (t_lb_m2s / t_lb_s2m) -> regfile
--
-- Generated by bust. Classic Wishbone is a single-beat, hold-until-ack protocol,
-- so the bridge is pure combinational glue: a qualified cycle (cyc_i and stb_i)
-- drives one local-bus transaction (we_i selects write vs read) and the regfile's
-- response is forwarded straight back as a one-cycle ack_o/err_o beat. No FSM and
-- no register stage of its own: the regfile's single registered cycle is the whole
-- latency, and its response guard provides transaction separation. Wishbone has a
-- native err_o line, so a regfile decode error maps to err_o; dat_o is still forced
-- to 0 on err so reads of invalid addresses stay deterministic. Wishbone's sync
-- active-high reset passes straight to the regfile, and the master drives a byte
-- address mapped directly onto the local bus.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_wishbone_endpoint is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true
  );
  port (
    clk_i   : in  std_logic;
    rst_i   : in  std_logic;

    -- Wishbone B4 classic subordinate interface
    cyc_i   : in  std_logic;
    stb_i   : in  std_logic;
    we_i    : in  std_logic;
    adr_i   : in  std_logic_vector({{ module.addr_width - 1 }} downto 0);
    dat_i   : in  std_logic_vector({{ module.data_width - 1 }} downto 0);
    dat_o   : out std_logic_vector({{ module.data_width - 1 }} downto 0);
    ack_o   : out std_logic;
    err_o   : out std_logic{% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}
    to_hw   : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_wishbone_endpoint;

architecture rtl of {{ module.name }}_wishbone_endpoint is

  signal m2s : t_lb_m2s;
  signal s2m : t_lb_s2m;

  signal qualified : std_logic;

begin

  i_regfile : entity work.{{ module.name }}_regfile
    generic map (
      G_BASE_ADDRESS       => G_BASE_ADDRESS,
      G_CHECK_BASE_ADDRESS => G_CHECK_BASE_ADDRESS,
      G_RESET_ACTIVE_LOW   => false)      -- Wishbone reset is sync active-high
    port map (
      clk     => clk_i,
      reset   => rst_i,
      lb_m2s  => m2s,
      lb_s2m  => s2m{% if module.to_hw_registers %},
      to_hw   => to_hw{% endif %}{% if module.from_hw_registers %},
      from_hw => from_hw{% endif %});

  qualified <= cyc_i and stb_i;

  m2s.address <= adr_i;
  m2s.wdata   <= dat_i;
  m2s.wen     <= qualified and we_i;
  m2s.ren     <= qualified and not we_i;

  ack_o <= s2m.ack;
  err_o <= s2m.err;
  dat_o <= (others => '0') when s2m.err = '1' else s2m.rdata;

end architecture rtl;
