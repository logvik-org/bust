-- {{ generated_by() }}
-- Protocol-agnostic register file for the {{ module.name }} module.
-- p_write: register storage and write response.
-- p_read: read mux and read response.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.{{ module.name }}_localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_regfile is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true;
    G_MODULE_ADDR_WIDTH  : natural := C_MODULE_ADDR_WIDTH;
    G_UNMAPPED_READ_DATA : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
    G_RESET_ACTIVE_LOW   : boolean := false
  );
  port (
    clk     : in  std_logic;
    reset   : in  std_logic;
    lb_m2s  : in  t_lb_m2s;
    lb_s2m  : out t_lb_s2m{% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}
    to_hw   : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_regfile;

architecture rtl of {{ module.name }}_regfile is

{% if module.stored_registers %}
  signal regs : t_{{ module.name }}_regs := C_{{ module.name | upper }}_REGS_RESET;

{% endif %}
  signal rst    : std_logic;            -- reset normalized to active high
  signal rdata  : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal wr_ack : std_logic := '0';
  signal wr_err : std_logic := '0';
  signal rd_ack : std_logic := '0';
  signal rd_err : std_logic := '0';
{% for reg in module.registers %}
{% for f in reg.effective_fields if f.swmod %}
  signal swmod_{{ reg.name }}_{{ f.name }} : std_logic := '0';
{% endfor %}
{% for f in reg.effective_fields if f.swacc %}
  signal swacc_{{ reg.name }}_{{ f.name }} : std_logic := '0';
{% endfor %}
{% endfor %}

begin

  rst <= (reset xor '1') when G_RESET_ACTIVE_LOW else reset;

  -- G_MODULE_ADDR_WIDTH must hold the registers and fit in the address.
  assert G_MODULE_ADDR_WIDTH >= C_MODULE_ADDR_WIDTH and G_MODULE_ADDR_WIDTH <= {{ module.addr_width }}
    report "G_MODULE_ADDR_WIDTH must be from C_MODULE_ADDR_WIDTH ("
           & natural'image(C_MODULE_ADDR_WIDTH) & ") to {{ module.addr_width }}"
    severity failure;

  -- The base address must be a multiple of the size of the address range.
  assert (not G_CHECK_BASE_ADDRESS)
      or (G_BASE_ADDRESS(G_MODULE_ADDR_WIDTH-1 downto 0) = 0)
    report "G_BASE_ADDRESS must be a multiple of 2**G_MODULE_ADDR_WIDTH"
    severity failure;

  -- Same-cycle precedence: hwclr > hwset > we/wel write > software write or onread.
  p_write : process (clk) is
    variable reg_offset : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0);
    variable mapped     : boolean;     -- a register sits at this address
    variable sw_write   : boolean;     -- a new software write to a register
    variable rd_service : boolean;     -- a new software read from a register
  begin
    if rising_edge(clk) then
      if rst = '1' then
{% if module.stored_registers %}
        regs       <= C_{{ module.name | upper }}_REGS_RESET;
{% endif %}
        wr_ack     <= '0';
        wr_err     <= '0';
{% for reg in module.registers %}
{% for f in reg.effective_fields if f.swmod %}
        swmod_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% for f in reg.effective_fields if f.swacc %}
        swacc_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% endfor %}
      else
        wr_ack <= '0';
        wr_err <= '0';

        -- A held request takes effect once, while its response is still low.
        reg_offset := lb_m2s.address(C_MODULE_ADDR_WIDTH-1 downto 0);
        mapped     := base_match(lb_m2s.address, G_BASE_ADDRESS, G_CHECK_BASE_ADDRESS,
                                 G_MODULE_ADDR_WIDTH)
                      and not above_registers(lb_m2s.address, G_MODULE_ADDR_WIDTH)
                      and is_mapped(reg_offset);
        sw_write   := lb_m2s.wen = '1' and wr_ack = '0' and wr_err = '0' and mapped;
        rd_service := lb_m2s.ren = '1' and rd_ack = '0' and rd_err = '0' and mapped;

{% for reg in module.registers if reg.stored_fields %}
{{ register_write(reg) }}

{% endfor %}
{% for reg in module.registers %}
{% set swmod_fields = reg.effective_fields | selectattr('swmod') | list %}
{% set swacc_fields = reg.effective_fields | selectattr('swacc') | list %}
{% if swmod_fields or swacc_fields %}
        -- {{ reg.name }} swmod and swacc strobes.
{% for f in swmod_fields %}
        swmod_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% for f in swacc_fields %}
        swacc_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
        if sw_write and reg_addr_match(reg_offset, C_ADDR_{{ reg.name | upper }}) then
{% for f in swmod_fields %}
          swmod_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% for f in swacc_fields %}
          swacc_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% if swacc_fields %}
        elsif rd_service and reg_addr_match(reg_offset, C_ADDR_{{ reg.name | upper }}) then
{% for f in swacc_fields %}
          swacc_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% endif %}
        end if;

{% endif %}
{% endfor %}
        -- Write response: ack for a register, err for any other address.
        if lb_m2s.wen = '1' and wr_ack = '0' and wr_err = '0' then
          if mapped then
            wr_ack <= '1';
          else
            wr_err <= '1';
          end if;
        end if;
      end if;
    end if;
  end process p_write;

  -- Unreadable fields read 0. An address without a register reads G_UNMAPPED_READ_DATA.
  p_read : process (clk) is
    variable reg_offset : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0);
    variable mapped     : boolean;     -- a register sits at this address
  begin
    if rising_edge(clk) then
      if rst = '1' then
        rdata  <= (others => '0');
        rd_ack <= '0';
        rd_err <= '0';
      else
        rd_ack <= '0';
        rd_err <= '0';

        if lb_m2s.ren = '1' and rd_ack = '0' and rd_err = '0' then
          rdata <= (others => '0');
          reg_offset := lb_m2s.address(C_MODULE_ADDR_WIDTH-1 downto 0);
          mapped     := base_match(lb_m2s.address, G_BASE_ADDRESS, G_CHECK_BASE_ADDRESS,
                                   G_MODULE_ADDR_WIDTH)
                        and not above_registers(lb_m2s.address, G_MODULE_ADDR_WIDTH)
                        and is_mapped(reg_offset);
          if not mapped then
            rd_err <= '1';
            rdata  <= G_UNMAPPED_READ_DATA;
{% for reg in module.registers %}
          elsif reg_addr_match(reg_offset, C_ADDR_{{ reg.name | upper }}) then
{% for f in reg.effective_fields if f.sw_readable %}
            rdata({{ f.vector_pos_vhdl if f.is_enum else f.get_pos_vhdl() }}) <= {{ ("to_slv(" ~ field_value(reg, f) ~ ")") if f.is_enum else field_value(reg, f) }};
{% endfor %}
            rd_ack <= '1';
{% endfor %}
          end if;
        end if;
      end if;
    end if;
  end process p_read;

{% if module.to_hw_registers %}
  -- Hardware-side outputs, one aggregate per register.
{% for reg in module.to_hw_registers %}
{% if reg.fields %}
  to_hw.{{ reg.name }} <= ({% for f in reg.to_hw_fields %}{{ f.name }} => {{ to_hw_value(reg, f) }}{% if not loop.last %}, {% endif %}{% endfor %});
{% else %}
  to_hw.{{ reg.name }} <= {{ to_hw_value(reg, reg.to_hw_fields[0]) }};
{% endif %}
{% endfor %}

{% endif %}
  lb_s2m.rdata <= rdata;
  lb_s2m.ack   <= wr_ack or rd_ack;
  lb_s2m.err   <= wr_err or rd_err;

end architecture rtl;
