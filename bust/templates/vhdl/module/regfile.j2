{% macro sw_action(reg, f) -%}
{% set lhs = "regs." ~ reg.name ~ "." ~ f.name -%}
{% set wslice = "lb_m2s.wdata(" ~ (f.vector_pos_vhdl if f.is_enum else f.get_pos_vhdl()) ~ ")" -%}
{%- if f.is_enum -%}{{ lhs }} <= to_{{ reg.name }}_{{ f.name }}({{ wslice }}){%- elif f.onwrite -%}{{ lhs }} <= {{ f.onwrite_rhs(lhs, wslice) }}{%- else -%}{{ lhs }} <= {{ wslice }}{%- endif -%}
{%- endmacro -%}
{% macro field_chain(reg, f) -%}
{% set lhs = "regs." ~ reg.name ~ "." ~ f.name -%}
{% set fin = "from_hw." ~ f.hw_path -%}
{% set ns = namespace(branches=[]) %}
{% if f.hwclr %}{% set ns.branches = ns.branches + [(fin ~ ".clr = '1'", lhs ~ " <= " ~ f.zeros_literal)] %}{% endif %}
{% if f.hwset %}{% set ns.branches = ns.branches + [(fin ~ ".set = '1'", lhs ~ " <= " ~ f.ones_literal)] %}{% endif %}
{% if f.we %}{% set ns.branches = ns.branches + [(fin ~ ".we = '1'", lhs ~ " <= " ~ fin ~ ".value")] %}{% endif %}
{% if f.wel %}{% set ns.branches = ns.branches + [(fin ~ ".wel = '0'", lhs ~ " <= " ~ fin ~ ".value")] %}{% endif %}
{% if f.sw_writable %}{% set ns.branches = ns.branches + [("sw_write and sel_is(sel, C_ADDR_" ~ reg.name | upper ~ ")", sw_action(reg, f))] %}{% endif %}
{% for cond, act in ns.branches %}
{% if loop.first %}
      if {{ cond }} then
{% else %}
      elsif {{ cond }} then
{% endif %}
        {{ act }};
{% endfor %}
{% if ns.branches %}
      end if;
{% endif %}
{%- endmacro -%}
{% macro register_write(reg) -%}
{% for f in reg.stored_fields %}
{% if f.singlepulse %}
      regs.{{ reg.name }}.{{ f.name }} <= {{ f.reset_value_vhdl }};
{% elif f.hw_writes_continuously %}
      regs.{{ reg.name }}.{{ f.name }} <= from_hw.{{ f.hw_path }}{{ ".value" if f.from_hw_is_record else "" }};
{% endif %}
{% endfor %}
{% set onread_fields = reg.effective_fields | selectattr('onread') | list %}
{% set later = namespace(writes=False) %}
{% for f in reg.stored_fields if f.sw_writable or f.we or f.wel or f.hwset or f.hwclr %}{% set later.writes = True %}{% endfor %}
{% if onread_fields %}
      -- {{ reg.name }} onread effects, applied when the software read is serviced.
      if rd_service and sel_is(sel, C_ADDR_{{ reg.name | upper }}) then
{% for f in onread_fields %}
        regs.{{ reg.name }}.{{ f.name }} <= {{ f.ones_literal if f.onread.value == 'rset' else f.zeros_literal }};
{% endfor %}
      end if;
{% if later.writes %}

{% endif %}
{% endif %}
{% for f in reg.stored_fields if (f.we or f.wel or f.hwset or f.hwclr) %}
{{ field_chain(reg, f) }}
{% endfor %}
{% set sw_fields = reg.stored_fields | selectattr('sw_writable') | rejectattr('we') | rejectattr('wel') | rejectattr('hwset') | rejectattr('hwclr') | list %}
{% if sw_fields %}
      if sw_write and sel_is(sel, C_ADDR_{{ reg.name | upper }}) then
{% for f in sw_fields %}
        {{ sw_action(reg, f) }};
{% endfor %}
      end if;
{% endif %}
{%- endmacro -%}
{# A constant enum is qualified because enum literal names (e.g. IDLE/BUSY) may be
   shared by several enum types, which would make to_slv(<literal>) ambiguous. #}
{% macro to_hw_value(reg, f) -%}
{%- if f.to_hw_is_record -%}(value => {{ field_value(reg, f) }}{% if f.swmod %}, swmod => swmod_{{ reg.name }}_{{ f.name }}{% endif %}{% if f.swacc %}, swacc => swacc_{{ reg.name }}_{{ f.name }}{% endif %}){%- else -%}{{ field_value(reg, f) }}{%- endif -%}
{%- endmacro -%}
{% macro field_value(reg, f) -%}
{%- if f.holds_state -%}regs.{{ reg.name }}.{{ f.name }}{%- elif f.is_enum -%}{{ f.enum_type_name }}'({{ f.reset_value_vhdl }}){%- else -%}{{ f.reset_value_vhdl }}{%- endif -%}
{%- endmacro -%}
-- Protocol-agnostic register file for the {{ module.name }} module.
-- Speaks only the local bus; protocol wrappers (AXI, IPBus, ...) instantiate it.
--
-- Generated by bust. p_write owns register storage (software writes, hardware
-- updates, and onread side effects, since all modify state) and the write
-- response; p_read owns the read mux and the read response. Concurrent output
-- assignments are grouped at the bottom.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.{{ module.name }}_localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_regfile is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true;
    -- Module address width: the module answers for 2**G_MODULE_ADDR_WIDTH
    -- addresses from its base address. An address in that range where no
    -- register sits gets an error response. The default is the smallest
    -- width that holds the registers.
    G_MODULE_ADDR_WIDTH  : natural := C_MODULE_ADDR_WIDTH;
    -- Reset polarity. The regfile normalizes internally so the rest of the
    -- logic is polarity-agnostic.
    G_RESET_ACTIVE_LOW   : boolean := false
  );
  port (
    clk     : in  std_logic;
    reset   : in  std_logic;
    lb_m2s  : in  t_lb_m2s;
    lb_s2m  : out t_lb_s2m{% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}
    to_hw   : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_regfile;

architecture rtl of {{ module.name }}_regfile is

{% if module.stored_registers %}
  signal regs : t_{{ module.name }}_regs := C_{{ module.name | upper }}_REGS_RESET;

{% endif %}
  signal rst    : std_logic;            -- reset normalized to active high
  signal rdata  : std_logic_vector({{ module.data_width - 1 }} downto 0);
  signal wr_ack : std_logic;
  signal wr_err : std_logic;
  signal rd_ack : std_logic;
  signal rd_err : std_logic;
{% for reg in module.registers %}
{% for f in reg.effective_fields if f.swmod %}
  signal swmod_{{ reg.name }}_{{ f.name }} : std_logic;
{% endfor %}
{% for f in reg.effective_fields if f.swacc %}
  signal swacc_{{ reg.name }}_{{ f.name }} : std_logic;
{% endfor %}
{% endfor %}

begin

  rst <= (reset xor '1') when G_RESET_ACTIVE_LOW else reset;

  assert G_MODULE_ADDR_WIDTH >= C_MODULE_ADDR_WIDTH and G_MODULE_ADDR_WIDTH <= {{ module.addr_width }}
    report "G_MODULE_ADDR_WIDTH must be from C_MODULE_ADDR_WIDTH ("
           & natural'image(C_MODULE_ADDR_WIDTH) & ") to {{ module.addr_width }}"
    severity failure;

  -- base_match compares only the base address bits, above the address range,
  -- so the base address must be a multiple of 2**G_MODULE_ADDR_WIDTH.
  assert (not G_CHECK_BASE_ADDRESS)
      or (G_BASE_ADDRESS(G_MODULE_ADDR_WIDTH-1 downto 0) = 0)
    report "G_BASE_ADDRESS must be a multiple of 2**G_MODULE_ADDR_WIDTH"
    severity failure;

  -- Register storage and write response. Single driver of `regs`: software
  -- writes, hardware updates, and onread side effects all live here. Each
  -- multi-source field uses an if/elsif chain so the precedence reads
  -- top-to-bottom: hwclr > hwset > hardware we/wel write > software write.
  -- A register's onread effects are assigned before its hardware updates, so
  -- hwclr, hwset or a we/wel write in the same cycle as a read wins over them.
  p_write : process (clk) is
    variable sel        : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0);
    variable hit        : boolean;     -- base address matches, not above the registers
    variable sw_write   : boolean;     -- a fresh software write that hits
    variable rd_service : boolean;     -- a fresh software read that hits
  begin
    if rising_edge(clk) then
      wr_ack <= '0';
      wr_err <= '0';

      -- A software access only takes effect on the cycle it is first seen
      -- (response still low); the master holds the request until it observes
      -- the response, so these guards keep the effect single-shot.
      sel        := lb_m2s.address(C_MODULE_ADDR_WIDTH-1 downto 0);
      hit        := base_match(lb_m2s.address, G_BASE_ADDRESS, G_CHECK_BASE_ADDRESS,
                               G_MODULE_ADDR_WIDTH)
                    and not above_registers(lb_m2s.address, G_MODULE_ADDR_WIDTH);
      sw_write   := lb_m2s.wen = '1' and wr_ack = '0' and wr_err = '0' and hit;
      rd_service := lb_m2s.ren = '1' and rd_ack = '0' and rd_err = '0' and hit;

{% for reg in module.registers if reg.stored_fields %}
{{ register_write(reg) }}

{% endfor %}
{% for reg in module.registers %}
{% set swmod_fields = reg.effective_fields | selectattr('swmod') | list %}
{% set swacc_fields = reg.effective_fields | selectattr('swacc') | list %}
{% if swmod_fields or swacc_fields %}
      -- {{ reg.name }} software-access strobes (swmod on write, swacc on any access).
{% for f in swmod_fields %}
      swmod_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% for f in swacc_fields %}
      swacc_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
      if sw_write and sel_is(sel, C_ADDR_{{ reg.name | upper }}) then
{% for f in swmod_fields %}
        swmod_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% for f in swacc_fields %}
        swacc_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% if swacc_fields %}
      elsif rd_service and sel_is(sel, C_ADDR_{{ reg.name | upper }}) then
{% for f in swacc_fields %}
        swacc_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% endif %}
      end if;

{% endif %}
{% endfor %}
      -- Write response: ack any mapped register, err an unmapped/out-of-range
      -- address.
      if lb_m2s.wen = '1' and wr_ack = '0' and wr_err = '0' then
        if hit and is_mapped(sel) then
          wr_ack <= '1';
        else
          wr_err <= '1';
        end if;
      end if;

      if rst = '1' then
{% if module.stored_registers %}
        regs       <= C_{{ module.name | upper }}_REGS_RESET;
{% endif %}
        wr_ack     <= '0';
        wr_err     <= '0';
{% for reg in module.registers %}
{% for f in reg.effective_fields if f.swmod %}
        swmod_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% for f in reg.effective_fields if f.swacc %}
        swacc_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% endfor %}
      end if;
    end if;
  end process p_write;

  -- Read mux and read response. Reads of non-readable fields (sw wo / na)
  -- return 0 and ack; err is reserved for address-decode failures.
  p_read : process (clk) is
    variable sel : std_logic_vector(C_MODULE_ADDR_WIDTH-1 downto 0);
    variable hit : boolean;            -- base address matches, not above the registers
  begin
    if rising_edge(clk) then
      rd_ack <= '0';
      rd_err <= '0';

      if lb_m2s.ren = '1' and rd_ack = '0' and rd_err = '0' then
        rdata <= (others => '0');
        sel   := lb_m2s.address(C_MODULE_ADDR_WIDTH-1 downto 0);
        hit   := base_match(lb_m2s.address, G_BASE_ADDRESS, G_CHECK_BASE_ADDRESS,
                            G_MODULE_ADDR_WIDTH)
                 and not above_registers(lb_m2s.address, G_MODULE_ADDR_WIDTH);
        if not hit then
          rd_err <= '1';
{% for reg in module.registers %}
        elsif sel_is(sel, C_ADDR_{{ reg.name | upper }}) then
{% for f in reg.effective_fields if f.sw_readable %}
          rdata({{ f.vector_pos_vhdl if f.is_enum else f.get_pos_vhdl() }}) <= {{ ("to_slv(" ~ field_value(reg, f) ~ ")") if f.is_enum else field_value(reg, f) }};
{% endfor %}
          rd_ack <= '1';
{% endfor %}
        else
          rd_err <= '1';
        end if;
      end if;

      if rst = '1' then
        rdata  <= (others => '0');
        rd_ack <= '0';
        rd_err <= '0';
      end if;
    end if;
  end process p_read;

{% if module.to_hw_registers %}
  -- Hardware-side outputs, one aggregate per register.
{% for reg in module.to_hw_registers %}
{% if reg.fields %}
  to_hw.{{ reg.name }} <= ({% for f in reg.to_hw_fields %}{{ f.name }} => {{ to_hw_value(reg, f) }}{% if not loop.last %}, {% endif %}{% endfor %});
{% else %}
  to_hw.{{ reg.name }} <= {{ to_hw_value(reg, reg.to_hw_fields[0]) }};
{% endif %}
{% endfor %}

{% endif %}
  lb_s2m.rdata <= rdata;
  lb_s2m.ack   <= wr_ack or rd_ack;
  lb_s2m.err   <= wr_err or rd_err;

end architecture rtl;
