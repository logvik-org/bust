{% macro sw_action(reg, f) -%}
{% set lhs = "regs." ~ reg.name ~ "." ~ f.name -%}
{% set wslice = "lb_m2s.wdata(" ~ (f.vector_pos_vhdl if f.is_enum else f.get_pos_vhdl()) ~ ")" -%}
{%- if f.is_enum -%}{{ lhs }} <= {{ f.from_slv_name }}({{ wslice }}){%- elif f.onwrite -%}{{ lhs }} <= {{ f.onwrite_rhs(lhs, wslice) }}{%- else -%}{{ lhs }} <= {{ wslice }}{%- endif -%}
{%- endmacro -%}
{% macro field_chain(reg, f) -%}
{% set lhs = "regs." ~ reg.name ~ "." ~ f.name -%}
{% set fin = "from_hw." ~ f.hw_path -%}
{% set ns = namespace(branches=[]) %}
{% if f.hwclr %}{% set ns.branches = ns.branches + [("(" ~ fin ~ ".clr = '1')", lhs ~ " <= " ~ f.zeros_literal)] %}{% endif %}
{% if f.hwset %}{% set ns.branches = ns.branches + [("(" ~ fin ~ ".set = '1')", lhs ~ " <= " ~ f.ones_literal)] %}{% endif %}
{% if f.we %}{% set ns.branches = ns.branches + [("(" ~ fin ~ ".we = '1')", lhs ~ " <= " ~ fin ~ ".value")] %}{% endif %}
{% if f.wel %}{% set ns.branches = ns.branches + [("(" ~ fin ~ ".wel = '0')", lhs ~ " <= " ~ fin ~ ".value")] %}{% endif %}
{% if f.sw_writable %}{% set ns.branches = ns.branches + [("(sw_write and reg_addr_match(reg_offset, " ~ reg.offset_constant ~ "))", sw_action(reg, f))] %}{% endif %}
{% for cond, act in ns.branches %}
{% if loop.first %}
        if {{ cond }} then
{% else %}
        elsif {{ cond }} then
{% endif %}
          {{ act }};
{% endfor %}
{% if ns.branches %}
        end if;
{% endif %}
{%- endmacro -%}
{% macro register_write(reg) -%}
{% for f in reg.stored_fields %}
{% if f.singlepulse %}
        regs.{{ reg.name }}.{{ f.name }} <= {{ f.reset_value_vhdl }};
{% elif f.hw_writes_continuously %}
        regs.{{ reg.name }}.{{ f.name }} <= from_hw.{{ f.hw_path }}{{ ".value" if f.from_hw_is_record else "" }};
{% endif %}
{% endfor %}
{% set onread_fields = reg.effective_fields | selectattr('onread') | list %}
{% set later = namespace(writes=False) %}
{% for f in reg.stored_fields if f.sw_writable or f.we or f.wel or f.hwset or f.hwclr %}{% set later.writes = True %}{% endfor %}
{% if onread_fields %}
        -- {{ reg.name }} onread effects.
        if (rd_service and reg_addr_match(reg_offset, {{ reg.offset_constant }})) then
{% for f in onread_fields %}
          regs.{{ reg.name }}.{{ f.name }} <= {{ f.ones_literal if f.onread.value == 'rset' else f.zeros_literal }};
{% endfor %}
        end if;
{% if later.writes %}

{% endif %}
{% endif %}
{% for f in reg.stored_fields if (f.we or f.wel or f.hwset or f.hwclr) %}
{{ field_chain(reg, f) }}
{% endfor %}
{% set sw_fields = reg.stored_fields | selectattr('sw_writable') | rejectattr('we') | rejectattr('wel') | rejectattr('hwset') | rejectattr('hwclr') | list %}
{% if sw_fields %}
        if (sw_write and reg_addr_match(reg_offset, {{ reg.offset_constant }})) then
{% for f in sw_fields %}
          {{ sw_action(reg, f) }};
{% endfor %}
        end if;
{% endif %}
{%- endmacro -%}
{# A constant enum is qualified because enum literal names (e.g. IDLE/BUSY) may be
   shared by several enum types, which would make to_slv(<literal>) ambiguous. #}
{% macro field_value(reg, f) -%}
{%- if f.holds_state -%}regs.{{ reg.name }}.{{ f.name }}{%- elif f.hw_wire -%}from_hw.{{ f.hw_path }}{%- elif f.is_enum -%}{{ f.enum_type_name }}'({{ f.reset_value_vhdl }}){%- else -%}{{ f.reset_value_vhdl }}{%- endif -%}
{%- endmacro -%}
{% set uses = namespace(rd_service=false, precedence=false) %}
{% for reg in module.registers %}{% for f in reg.effective_fields %}
{% if f.onread or f.swacc %}{% set uses.rd_service = true %}{% endif %}
{% if f.hwset or f.hwclr or f.we or f.wel %}{% set uses.precedence = true %}{% endif %}
{% endfor %}{% endfor %}
{% set width = "C_" ~ (module.name | upper) ~ "_MODULE_ADDR_WIDTH" %}
-- {{ generated_by() }}
-- Protocol-agnostic register file for the {{ module.name }} module.
-- p_write: register storage and write response.
-- p_read: read mux and read response.

library ieee;
  use ieee.std_logic_1164.all;
  use ieee.numeric_std.all;
  use work.{{ module.name }}_localbus_pkg.all;
  use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_regfile is
  generic (
{% filter align(":", ":=") %}
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true;
    G_MODULE_ADDR_WIDTH  : natural := {{ width }};
    G_UNMAPPED_READ_DATA : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
    G_ERR_ON_BAD_ACCESS  : boolean := false;
    G_RESET_ACTIVE_LOW   : boolean := false
{% endfilter %}
  );
  port (
{% filter align(":") %}
    clk : in    std_logic;
    reset : in    std_logic;
    lb_m2s : in    t_lb_m2s;
    lb_s2m : out   t_lb_s2m{{ ";" if module.to_hw_registers or module.from_hw_registers else "" }}
{% if module.to_hw_registers %}
    to_hw : out   t_{{ module.name }}_to_hw{{ ";" if module.from_hw_registers else "" }}
{% endif %}
{% if module.from_hw_registers %}
    from_hw : in    t_{{ module.name }}_from_hw
{% endif %}
{% endfilter %}
  );
end entity {{ module.name }}_regfile;

architecture rtl of {{ module.name }}_regfile is

{% if module.stored_registers %}
  signal regs : t_{{ module.name }}_regs := C_{{ module.name | upper }}_REGS_RESET;

{% endif %}
{% filter align(":", ":=") %}
  signal rdata : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal wr_ack : std_logic := '0';
  signal wr_err : std_logic := '0';
  signal rd_ack : std_logic := '0';
  signal rd_err : std_logic := '0';
{% for reg in module.registers %}
{% for f in reg.effective_fields if f.swmod %}
  signal swmod_{{ reg.name }}_{{ f.name }} : std_logic := '0';
{% endfor %}
{% for f in reg.effective_fields if f.swacc %}
  signal swacc_{{ reg.name }}_{{ f.name }} : std_logic := '0';
{% endfor %}
{% endfor %}
{% endfilter %}

  -- reset is compared with this level directly, so it adds no delta cycle.
  function reset_level (
    active_low : boolean
  ) return std_logic is
  begin

    if (active_low) then
      return '0';
    end if;

    return '1';

  end function reset_level;

  constant C_RESET_LEVEL : std_logic := reset_level(G_RESET_ACTIVE_LOW);

begin

  -- G_MODULE_ADDR_WIDTH must hold the registers and fit in the address.
  assert G_MODULE_ADDR_WIDTH >= {{ width }}
      and G_MODULE_ADDR_WIDTH <= {{ module.addr_width }}
    report "G_MODULE_ADDR_WIDTH must be from {{ width }} ("
           & natural'image({{ width }}) & ") to {{ module.addr_width }}"
    severity failure;

  -- The base address must be a multiple of the size of the address range.
  assert (not G_CHECK_BASE_ADDRESS)
      or (G_BASE_ADDRESS(G_MODULE_ADDR_WIDTH - 1 downto 0) = 0)
    report "G_BASE_ADDRESS must be a multiple of 2**G_MODULE_ADDR_WIDTH"
    severity failure;

{% if uses.precedence %}
  -- Same-cycle precedence: hwclr > hwset > we/wel write > software write or onread.
{% endif %}
  p_write : process (clk) is

    variable reg_offset : std_logic_vector({{ width }} - 1 downto 0);
    variable mapped     : boolean; -- a register sits at this address
    variable sw_write   : boolean; -- a new software write to a register
{% if uses.rd_service %}
    variable rd_service : boolean; -- a new software read from a register
{% endif %}

  begin

{% filter align("<=|:=") %}
    if rising_edge(clk) then
      if (reset = C_RESET_LEVEL) then
{% if module.stored_registers %}
        regs <= C_{{ module.name | upper }}_REGS_RESET;
{% endif %}
        wr_ack <= '0';
        wr_err <= '0';
{% for reg in module.registers %}
{% for f in reg.effective_fields if f.swmod %}
        swmod_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% for f in reg.effective_fields if f.swacc %}
        swacc_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% endfor %}
      else
        wr_ack <= '0';
        wr_err <= '0';

        -- A held request takes effect once, while its response is still low.
        reg_offset := lb_m2s.address({{ width }} - 1 downto 0);
        mapped     := base_match(lb_m2s.address, G_BASE_ADDRESS, G_CHECK_BASE_ADDRESS,
                                 G_MODULE_ADDR_WIDTH)
                      and not above_registers(lb_m2s.address, G_MODULE_ADDR_WIDTH)
                      and is_mapped(reg_offset);
        sw_write   := lb_m2s.wen = '1' and wr_ack = '0' and wr_err = '0' and mapped;
{% if uses.rd_service %}
        rd_service := lb_m2s.ren = '1' and rd_ack = '0' and rd_err = '0' and mapped;
{% endif %}

{% for reg in module.registers if reg.stored_fields %}
{{ register_write(reg) }}

{% endfor %}
{% for reg in module.registers %}
{% set swmod_fields = reg.effective_fields | selectattr('swmod') | list %}
{% set swacc_fields = reg.effective_fields | selectattr('swacc') | list %}
{% if swmod_fields or swacc_fields %}
        -- {{ reg.name }} swmod and swacc strobes.
{% for f in swmod_fields %}
        swmod_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
{% for f in swacc_fields %}
        swacc_{{ reg.name }}_{{ f.name }} <= '0';
{% endfor %}
        if (sw_write and reg_addr_match(reg_offset, {{ reg.offset_constant }})) then
{% for f in swmod_fields %}
          swmod_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% for f in swacc_fields %}
          swacc_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% if swacc_fields %}
        elsif (rd_service and reg_addr_match(reg_offset, {{ reg.offset_constant }})) then
{% for f in swacc_fields %}
          swacc_{{ reg.name }}_{{ f.name }} <= '1';
{% endfor %}
{% endif %}
        end if;

{% endif %}
{% endfor %}
        -- Write response: err for an address without a register or a bad access.
        if (lb_m2s.wen = '1' and wr_ack = '0' and wr_err = '0') then
          if (mapped and (is_sw_writable(reg_offset) or not G_ERR_ON_BAD_ACCESS)) then
            wr_ack <= '1';
          else
            wr_err <= '1';
          end if;
        end if;
      end if;
    end if;
{% endfilter %}

  end process p_write;

  -- Unreadable fields read 0. A read that gets err returns G_UNMAPPED_READ_DATA.
  p_read : process (clk) is

    variable reg_offset : std_logic_vector({{ width }} - 1 downto 0);
    variable mapped     : boolean; -- a register sits at this address

  begin

{% filter align("<=|:=") %}
    if rising_edge(clk) then
      if (reset = C_RESET_LEVEL) then
        rdata  <= (others => '0');
        rd_ack <= '0';
        rd_err <= '0';
      else
        rd_ack <= '0';
        rd_err <= '0';

        if (lb_m2s.ren = '1' and rd_ack = '0' and rd_err = '0') then
          rdata <= (others => '0');
          reg_offset := lb_m2s.address({{ width }} - 1 downto 0);
          mapped     := base_match(lb_m2s.address, G_BASE_ADDRESS, G_CHECK_BASE_ADDRESS,
                                   G_MODULE_ADDR_WIDTH)
                        and not above_registers(lb_m2s.address, G_MODULE_ADDR_WIDTH)
                        and is_mapped(reg_offset);
          if (not mapped or (G_ERR_ON_BAD_ACCESS and not is_sw_readable(reg_offset))) then
            rd_err <= '1';
            rdata  <= G_UNMAPPED_READ_DATA;
{% for reg in module.registers %}
          elsif reg_addr_match(reg_offset, {{ reg.offset_constant }}) then
{% for f in reg.effective_fields if f.sw_readable %}
            rdata({{ f.vector_pos_vhdl if f.is_enum else f.get_pos_vhdl() }}) <= {{ ("to_slv(" ~ field_value(reg, f) ~ ")") if f.is_enum else field_value(reg, f) }};
{% endfor %}
            rd_ack <= '1';
{% endfor %}
          end if;
        end if;
      end if;
    end if;
{% endfilter %}

  end process p_read;

{% if module.to_hw_registers %}
  -- Hardware-side outputs.
{% filter align("<=") %}
{% for reg in module.to_hw_registers %}
{% for f in reg.to_hw_fields %}
{% set target = "to_hw." ~ reg.name ~ ("." ~ f.name if reg.fields else "") %}
{% if f.to_hw_is_record %}
  {{ target }}.value <= {{ field_value(reg, f) }};
{% if f.swmod %}
  {{ target }}.swmod <= swmod_{{ reg.name }}_{{ f.name }};
{% endif %}
{% if f.swacc %}
  {{ target }}.swacc <= swacc_{{ reg.name }}_{{ f.name }};
{% endif %}
{% else %}
  {{ target }} <= {{ field_value(reg, f) }};
{% endif %}
{% endfor %}
{% endfor %}
{% endfilter %}

{% endif %}
  lb_s2m.rdata <= rdata;
  lb_s2m.ack   <= wr_ack or rd_ack;
  lb_s2m.err   <= wr_err or rd_err;

end architecture rtl;
