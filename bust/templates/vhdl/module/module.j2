library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

-- User Libraries Start

-- User Libraries End

library {{ bus.comp_library }};
{% if bus.bus_type == "ipbus" %}
use {{ bus.comp_library }}.ipbus.all;
use work.{{ module.name }}_pif_pkg.all;
{% elif bus.bus_type == "axi" %}
use {{ bus.comp_library }}.axi_pkg.all;
use work.{{ module.name }}_pif_pkg.all;
{% endif %}

entity {{ module.name }} is

  generic (
    -- User Generics Start

    -- User Generics End
    {% if bus.bus_type == "ipbus" %}
    -- IPBUS Bus Interface Generics
    g_ipb_baseaddr        : std_logic_vector({{ bus.addr_width-1 }} downto 0) := (others => '0');
    g_check_baseaddr      : boolean := true;
    g_module_addr_width   : integer := 0
    {% elif bus.bus_type == "axi" %}
    -- AXI Bus Interface Generics
    g_axi_baseaddr        : std_logic_vector({{ bus.addr_width-1 }} downto 0) := (others => '0');
    g_check_baseaddr      : boolean := true;
    g_module_addr_width   : integer := 0
    {% endif %}
    );
  port (
    -- User Ports Start

    -- User Ports End
    {% if bus.bus_type == "ipbus" %}
    -- IPBUS Bus Interface Ports
    ipb_clk      : in  std_logic;
    ipb_reset    : in  std_logic;
    ipb_in       : in  ipb_wbus;
    ipb_out      : out ipb_rbus
    {% elif bus.bus_type == "axi" %}
    -- AXI Bus Interface Ports
    axi_clk      : in  std_logic;
    axi_areset_n : in  std_logic;
    axi_in       : in  t_axi_mosi;
    axi_out      : out t_axi_miso
    {% endif %}
    );

end entity {{ module.name }};

architecture rtl of {{ module.name }} is

  -- User Architecture Start

  -- User Architecture End

  {% if bus.bus_type == "ipbus" %}
  -- IPBUS output signal for user readback
  signal ipb_out_i : ipb_rbus;
  {% elif bus.bus_type == "axi" %}
  -- AXI output signal for user readback
  signal axi_out_i : t_axi_miso;
  {% endif %}
  -- Register Signals
  {% if module.n_rw_regs > 0 %}
  signal {{bus.short_name }}_rw_regs    : t_{{ module.name }}_rw_regs    := c_{{ module.name }}_rw_regs;
  {% endif %}
  {% if module.n_ro_regs > 0 %}
  signal {{bus.short_name }}_ro_regs    : t_{{ module.name }}_ro_regs    := c_{{ module.name }}_ro_regs;
  {% endif %}
  {% if module.n_pulse_regs > 0 %}
  signal {{bus.short_name }}_pulse_regs : t_{{ module.name }}_pulse_regs := c_{{ module.name }}_pulse_regs;
  {% endif %}

begin

  -- User Logic Start

  -- User Logic End

  {% if bus.bus_type == "ipbus" %}
  ipb_out <= ipb_out_i;

  {% macro pif_inst() %}{% include "vhdl/module/pif_instantiation_ipbus.j2" %}{% endmacro %}
  {{ pif_inst()|indent(2) }}
  {% elif bus.bus_type == "axi" %}
  axi_out <= axi_out_i;

  {% macro pif_inst() %}{% include "vhdl/module/pif_instantiation_axi.j2" %}{% endmacro %}
  {{ pif_inst()|indent(2) }}
  {% endif %}

end architecture rtl;

