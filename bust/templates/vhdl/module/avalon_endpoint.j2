-- Avalon-MM wrapper for the {{ module.name }} local-bus register file.
--   Avalon-MM -> local bus (t_lb_m2s / t_lb_s2m) -> regfile
--
-- Generated by bust. Avalon-MM stalls with waitrequest: the master holds the
-- command (chipselect with read or write) until the slave drops waitrequest, and
-- for a waitrequest-controlled read (no readdatavalid) readdata is valid on the
-- cycle waitrequest deasserts. The bridge is pure combinational glue: the command
-- drives one local-bus transaction and the regfile's response is forwarded
-- straight back, dropping waitrequest for the single cycle the regfile answers. No
-- FSM and no register stage of its own: the regfile's single registered cycle is
-- the whole latency, and its response guard provides transaction separation.
-- waitrequest=1 is "not ready"; the accept beat is one cycle of waitrequest=0 when
-- the regfile answers (ack or err). With no command, ack/err are low so
-- waitrequest defaults high. The optional Avalon-MM response signal is not used, so
-- a decode error completes as a normal beat with readdata forced to 0.
-- Avalon-MM's reset is sync active-high, passed straight to
-- the regfile, and the master drives a byte address mapped directly onto the local
-- bus.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.{{ module.name }}_localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_avalon_endpoint is
  generic (
    G_BASE_ADDRESS       : unsigned({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";
    G_CHECK_BASE_ADDRESS : boolean := true;
    G_MODULE_ADDR_WIDTH  : natural := C_MODULE_ADDR_WIDTH;
    G_UNMAPPED_READ_DATA : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0')
  );
  port (
    clk         : in  std_logic;
    reset       : in  std_logic;

    -- Avalon-MM subordinate interface
    chipselect  : in  std_logic;
    address     : in  std_logic_vector({{ module.addr_width - 1 }} downto 0);
    read        : in  std_logic;
    write       : in  std_logic;
    writedata   : in  std_logic_vector({{ module.data_width - 1 }} downto 0);
    waitrequest : out std_logic;
    readdata    : out std_logic_vector({{ module.data_width - 1 }} downto 0){% if module.to_hw_registers or module.from_hw_registers %};{% endif %}

{% if module.to_hw_registers %}
    to_hw       : out t_{{ module.name }}_to_hw{% if module.from_hw_registers %};{% endif %}

{% endif %}
{% if module.from_hw_registers %}
    from_hw     : in  t_{{ module.name }}_from_hw
{% endif %}
  );
end entity {{ module.name }}_avalon_endpoint;

architecture rtl of {{ module.name }}_avalon_endpoint is

  signal m2s : t_lb_m2s;
  signal s2m : t_lb_s2m;

begin

  i_regfile : entity work.{{ module.name }}_regfile
    generic map (
      G_BASE_ADDRESS       => G_BASE_ADDRESS,
      G_CHECK_BASE_ADDRESS => G_CHECK_BASE_ADDRESS,
      G_MODULE_ADDR_WIDTH  => G_MODULE_ADDR_WIDTH,
      G_UNMAPPED_READ_DATA => G_UNMAPPED_READ_DATA,
      G_RESET_ACTIVE_LOW   => false)      -- Avalon-MM reset is sync active-high
    port map (
      clk     => clk,
      reset   => reset,
      lb_m2s  => m2s,
      lb_s2m  => s2m{% if module.to_hw_registers %},
      to_hw   => to_hw{% endif %}{% if module.from_hw_registers %},
      from_hw => from_hw{% endif %});

  m2s.address <= address;
  m2s.wdata   <= writedata;
  m2s.wen     <= chipselect and write;
  m2s.ren     <= chipselect and read;

  -- waitrequest=1 stalls; the accept beat is one cycle of waitrequest=0 when the
  -- regfile answers. With no command, ack/err are low so waitrequest stays high.
  waitrequest <= not (s2m.ack or s2m.err);
  readdata    <= s2m.rdata;

end architecture rtl;
