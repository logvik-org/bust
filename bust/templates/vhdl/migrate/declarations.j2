  -- Register signals, connected to {{ module.name }}_{{ bus.endpoint_suffix }} by bust --migrate.
{% if module.to_hw_registers %}
  signal to_hw   : t_{{ module.name }}_to_hw;
{% endif %}
{% if module.from_hw_registers %}
  signal from_hw : t_{{ module.name }}_from_hw := C_{{ module.name | upper }}_FROM_HW_RESET;
{% endif %}
