use ieee.numeric_std.all;

library uvvm_util;
context uvvm_util.uvvm_util_context;
use work.{{ module.name }}_localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_tb is
end entity {{ module.name }}_tb;

architecture tb of {{ module.name }}_tb is

  constant C_SCOPE      : string := C_TB_SCOPE_DEFAULT;
  constant C_CLK_PERIOD : time   := 10 ns;

  constant C_BASE : std_logic_vector({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";

  -- presetn is active low, so gen_pulse asserts it low.
  signal clk     : std_logic := '0';
  signal presetn : std_logic := '1';
{% include "vhdl/testbench/localbus_tb/hw_signals.j2" %}

{% filter align(":", ":=") %}
  signal apb_psel : std_logic := '0';
  signal apb_penable : std_logic := '0';
  signal apb_pwrite : std_logic := '0';
  signal apb_paddr : std_logic_vector({{ module.addr_width - 1 }} downto 0) := (others => '0');
  signal apb_pwdata : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal apb_prdata : std_logic_vector({{ module.data_width - 1 }} downto 0);
  signal apb_pready : std_logic;
  signal apb_pslverr : std_logic;
{% endfilter %}

  function f_addr (
    reg : std_logic_vector({{ module.addr_width - 1 }} downto 0)
  ) return unsigned is
  begin

    return unsigned(C_BASE) + unsigned(reg);

  end function f_addr;
{% include "vhdl/testbench/localbus_tb/monitor_signals.j2" %}

begin

  clock_generator(clk, C_CLK_PERIOD);

  dut : entity work.{{ module.name }}_{{ module.bus.endpoint_suffix }}(rtl)
    generic map (
      G_BASE_ADDRESS       => unsigned(C_BASE),
      G_CHECK_BASE_ADDRESS => true,
      G_MODULE_ADDR_WIDTH  => {{ tb.module_addr_width }},
      G_UNMAPPED_READ_DATA => C_UNMAPPED_READ_DATA,
      G_ERR_ON_BAD_ACCESS  => true
    )
    port map (
{% filter align("=>") %}
      pclk => clk,
      presetn => presetn,
      psel => apb_psel,
      penable => apb_penable,
      pwrite => apb_pwrite,
      paddr => apb_paddr,
      pwdata => apb_pwdata,
      prdata => apb_prdata,
      pready => apb_pready,
      pslverr => apb_pslverr{{ "," if module.to_hw_registers or module.from_hw_registers else "" }}
{% if module.to_hw_registers %}
      to_hw => to_hw{{ "," if module.from_hw_registers else "" }}
{% endif %}
{% if module.from_hw_registers %}
      from_hw => from_hw
{% endif %}
{% endfilter %}
    );
{% include "vhdl/testbench/localbus_tb/monitor_process.j2" %}

  p_main : process is

    -- APB single write: SETUP (psel, penable low), then ACCESS (penable high)
    -- held until pready.
    procedure bus_write (
      constant addr       : in unsigned;
      constant data       : in std_logic_vector;
      constant msg        : in string;
      constant expect_err : in boolean := false
    ) is
    begin

      apb_psel    <= '1';
      apb_penable <= '0';
      apb_pwrite  <= '1';
      apb_paddr   <= std_logic_vector(addr);
      apb_pwdata  <= data;
      wait until rising_edge(clk);
      apb_penable <= '1';
      wait until rising_edge(clk);

      while apb_pready = '0' loop

        wait until rising_edge(clk);

      end loop;

      if expect_err then
        check_value(apb_pslverr, '1', error, "write must complete with pslverr: " & msg, C_SCOPE);
      else
        check_value(apb_pslverr, '0', error, "write must complete without pslverr: " & msg, C_SCOPE);
      end if;

      apb_psel    <= '0';
      apb_penable <= '0';
      apb_pwrite  <= '0';
      apb_paddr   <= (others => '0');
      apb_pwdata  <= (others => '0');
      wait for 0 ns;

    end procedure bus_write;

    -- APB single read: drive the SETUP/ACCESS phases, hold until the regfile
    -- answers, then return the read data and the pslverr termination flag.
    procedure bus_read (
      constant addr    : in unsigned;
      variable data    : out std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable got_err : out boolean
    ) is
    begin

      apb_psel    <= '1';
      apb_penable <= '0';
      apb_pwrite  <= '0';
      apb_paddr   <= std_logic_vector(addr);
      wait until rising_edge(clk);
      apb_penable <= '1';
      wait until rising_edge(clk);

      while apb_pready = '0' loop

        wait until rising_edge(clk);

      end loop;

      data        := apb_prdata;
      got_err     := apb_pslverr = '1';
      apb_psel    <= '0';
      apb_penable <= '0';
      apb_paddr   <= (others => '0');
      wait for 0 ns;

    end procedure bus_read;

    procedure bus_check (
      constant addr : in unsigned;
      constant data : in std_logic_vector;
      constant msg  : in string
    ) is

      variable v_data    : std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable v_got_err : boolean;

    begin

      bus_read(addr, v_data, v_got_err);
      check_value(v_got_err, false, error, msg & " (terminated without error)", C_SCOPE);
      check_value(v_data, data, error, msg, C_SCOPE);

    end procedure bus_check;

    -- An address without a register completes with pslverr.
    procedure bus_write_unmapped (
      constant addr : in unsigned;
      constant data : in std_logic_vector;
      constant msg  : in string
    ) is
    begin

      bus_write(addr, data, msg, expect_err => true);

    end procedure bus_write_unmapped;

    procedure bus_check_unmapped (
      constant addr : in unsigned;
      constant msg  : in string
    ) is

      variable v_data    : std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable v_got_err : boolean;

    begin

      bus_read(addr, v_data, v_got_err);
      check_value(v_got_err, true, error, msg & " (terminated on pslverr)", C_SCOPE);
      check_value(v_data, C_UNMAPPED_READ_DATA, error, msg, C_SCOPE);

    end procedure bus_check_unmapped;
{% include "vhdl/testbench/localbus_tb/snapshot_vars.j2" %}

  begin

    disable_log_msg(ALL_MESSAGES, QUIET);
    enable_log_msg(ID_LOG_HDR, QUIET);

    gen_pulse(presetn, '0', 500 ns, BLOCKING, "Reset for 500 ns");
{% include "vhdl/testbench/localbus_tb/test_sequence.j2" %}

    wait for 10 * C_CLK_PERIOD;
    report_alert_counters(FINAL);
    log(ID_LOG_HDR, "SIMULATION COMPLETED", C_SCOPE);
    std.env.stop;
    wait;

  end process p_main;

end architecture tb;
