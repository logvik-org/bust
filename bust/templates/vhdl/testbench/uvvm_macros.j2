{% macro pif_instantiation(module, bus, name, inter) %}
DUT : entity work.{{ module.name }}_{{ bus.short_name }}_pif
  generic map (
    g_{{ bus.short_name }}_baseaddr      => g_{{ bus.short_name }}_baseaddr,
    g_check_baseaddr    => g_check_baseaddr,
    g_module_addr_width => g_module_addr_width)
  port map (
{% if module.num_rw_regs > 0 %}    {{ bus.short_name }}_rw_regs         => {{ bus.short_name }}_rw_regs,
{% endif -%}
{% if module.num_ro_regs > 0 %}    {{ bus.short_name }}_ro_regs         => {{ bus.short_name }}_ro_regs,
{% endif -%}
{% if module.num_pulse_regs > 0 %}    {{ bus.short_name }}_pulse_regs      => {{ bus.short_name }}_pulse_regs,
{% endif %}    {{ bus.clk_name.strip() }}                 => {{ bus.short_name }}_{{ bus.clk_name.strip() }},
    {{ bus.reset_name.strip() }}            => {{ bus.short_name }}_{{ bus.reset_name.strip() }},
{% if bus.bus_type == 'axi' %}
    awaddr              => {{ bus.short_name }}_in.awaddr(C_{{ name | upper }}_ADDR_WIDTH-1 downto 0),
    awvalid             => {{ bus.short_name }}_in.awvalid,
    awready             => {{ bus.short_name }}_out.awready,
    wdata               => {{ bus.short_name }}_in.wdata(C_{{ name | upper }}_DATA_WIDTH-1 downto 0),
    wvalid              => {{ bus.short_name }}_in.wvalid,
    wready              => {{ bus.short_name }}_out.wready,
    bresp               => {{ bus.short_name }}_out.bresp,
    bvalid              => {{ bus.short_name }}_out.bvalid,
    bready              => {{ bus.short_name }}_in.bready,
    araddr              => {{ bus.short_name }}_in.araddr(C_{{ name | upper }}_ADDR_WIDTH-1 downto 0),
    arvalid             => {{ bus.short_name }}_in.arvalid,
    arready             => {{ bus.short_name }}_out.arready,
    rdata               => {{ bus.short_name }}_out.rdata(C_{{ name | upper }}_DATA_WIDTH-1 downto 0),
    rresp               => {{ bus.short_name }}_out.rresp,
    rvalid              => {{ bus.short_name }}_out.rvalid,
    rready              => {{ bus.short_name }}_in.rready
{% elif bus.bus_type == 'ipbus' %}
    ipb_in              => ipb_in,
    ipb_out             => ipb_out
{% endif %}
    );
{% endmacro %}

{% macro uvvm_lib(bus) -%}
{%- if bus.bus_type == "axi" %}
library bitvis_vip_axilite;
use bitvis_vip_axilite.axilite_bfm_pkg.all;
{%- elif bus.bus_type == "ipbus" %}
library vip_ipbus;
use vip_ipbus.ipbus_bfm_pkg.all;
{%- endif %}
{%- endmacro %}

{% macro uvvm_signals(bus) -%}
{%- if bus.bus_type == "axi" %}-- Bitvis UVVM AXILITE BFM
{%- elif bus.bus_type == "ipbus" %}-- vip_ipbus BFM
{%- endif %}

constant data_width : natural := {{ bus.data_width }};
constant addr_width : natural := {{ bus.addr_width }};

{%- if bus.bus_type == "axi" %}

signal axilite_if : t_axilite_if(write_address_channel(awaddr(addr_width -1 downto 0)),
                                 write_data_channel(wdata(data_width -1 downto 0),
                                                    wstrb((data_width/8) -1 downto 0)),
                                 read_address_channel(araddr(addr_width -1 downto 0)),
                                 read_data_channel(rdata(data_width -1 downto 0))) := init_axilite_if_signals(data_width, addr_width);
signal axilite_bfm_config : t_axilite_bfm_config := C_AXILITE_BFM_CONFIG_DEFAULT;

-- Unused AXILITE signals
signal dummy_arprot : std_logic_vector(2 downto 0);
signal dummy_awprot : std_logic_vector(2 downto 0);
signal dummy_wstrb  : std_logic_vector((data_width/8)-1 downto 0);
{% elif bus.bus_type == "ipbus" %}

signal ipbus_if : t_ipbus_if := init_ipbus_if_signals;
signal ipbus_bfm_config : t_ipbus_bfm_config := C_IPBUS_BFM_CONFIG_DEFAULT;
{% endif %}
{%- endmacro %}

{% macro uvvm_signal_assignment(bus) -%}
{%- if bus.bus_type == "axi" %}
axilite_bfm_config.clock_period      <= C_CLK_PERIOD;
axilite_bfm_config.setup_time        <= C_CLK_PERIOD/8;
axilite_bfm_config.hold_time         <= C_CLK_PERIOD/8;
axilite_bfm_config.num_b_pipe_stages <= 0;

axi_in.araddr  <= axilite_if.read_address_channel.araddr;
dummy_arprot   <= axilite_if.read_address_channel.arprot;
axi_in.arvalid <= axilite_if.read_address_channel.arvalid;
axi_in.awaddr  <= axilite_if.write_address_channel.awaddr;
dummy_awprot   <= axilite_if.write_address_channel.awprot;
axi_in.awvalid <= axilite_if.write_address_channel.awvalid;
axi_in.bready  <= axilite_if.write_response_channel.bready;
axi_in.rready  <= axilite_if.read_data_channel.rready;
axi_in.wdata   <= axilite_if.write_data_channel.wdata;
dummy_wstrb    <= axilite_if.write_data_channel.wstrb;
axi_in.wvalid  <= axilite_if.write_data_channel.wvalid;

axilite_if.read_address_channel.arready  <= axi_out.arready;
axilite_if.write_address_channel.awready <= axi_out.awready;
axilite_if.write_response_channel.bresp  <= axi_out.bresp;
axilite_if.write_response_channel.bvalid <= axi_out.bvalid;
axilite_if.read_data_channel.rdata       <= axi_out.rdata;
axilite_if.read_data_channel.rresp       <= axi_out.rresp;
axilite_if.read_data_channel.rvalid      <= axi_out.rvalid;
axilite_if.write_data_channel.wready     <= axi_out.wready;
{%- elif bus.bus_type == "ipbus" %}
ipbus_bfm_config.clock_period    <= C_CLK_PERIOD;
ipbus_bfm_config.setup_time      <= C_CLK_PERIOD/8;
ipbus_bfm_config.hold_time       <= C_CLK_PERIOD/8;
ipbus_bfm_config.max_wait_cycles <= 256;

ipb_in.ipb_wdata  <= ipbus_if.wdata;
ipb_in.ipb_write  <= ipbus_if.wr;
ipb_in.ipb_addr   <= ipbus_if.addr;
ipb_in.ipb_strobe <= ipbus_if.strobe;

ipbus_if.rdata <= ipb_out.ipb_rdata;
ipbus_if.ack   <= ipb_out.ipb_ack;
ipbus_if.err   <= ipb_out.ipb_err;
{%- endif %}
{%- endmacro %}

{% macro uvvm_overloads(bus) -%}
-- Overloads for convenience
procedure log_hdr (
  constant msg : in string) is
begin  -- procedure log_hdr
  log(ID_LOG_HDR, msg, C_SCOPE);
end procedure log_hdr;

-- Overloads for convenience
procedure log_hdr_large (
  constant msg : in string) is
begin  -- procedure log_hdr
  log(ID_LOG_HDR_LARGE, msg, C_SCOPE);
end procedure log_hdr_large;

{% set ext_name = "axilite" if bus.bus_type == "axi" else bus.bus_type -%}
procedure write(
  constant addr_value : in unsigned;
  constant data_value : in std_logic_vector;
  constant msg        : in string) is
begin
  {{ ext_name }}_write(addr_value,
                data_value,
                msg,
                {{ bus.short_name }}_{{ bus.clk_name.strip() }},
                {{ ext_name }}_if,
                C_SCOPE,
                shared_msg_id_panel,
                {{ ext_name }}_bfm_config);
end;

procedure read(
  constant addr_value : in  unsigned;
  variable data_value : out std_logic_vector;
  constant msg        : in  string) is
begin
  {{ ext_name }}_read(addr_value,
               data_value,
               msg,
               {{ bus.short_name }}_{{ bus.clk_name.strip() }},
               {{ ext_name }}_if,
               C_SCOPE,
               shared_msg_id_panel,
               {{ ext_name }}_bfm_config);
end;

variable dummy_data : std_logic_vector(31 downto 0);
{%- endmacro %}

{# Register test macros - simplified versions #}
{% macro reg_hdr(reg) -%}
{%- if reg.type == 'SL' -%}
{%- set reg_type = "SL" -%}
{%- elif reg.type in ['SLV', 'DEFAULT'] -%}
{%- set reg_type = reg.type -%}
{%- elif reg.type == 'FIELDS' -%}
{%- set reg_type = "FIELDS" -%}
{%- endif -%}
log_hdr_large("Checking Register " + reg.name + " - " + reg.mode.value.upper() + " - " + reg_type);
{%- endmacro %}

