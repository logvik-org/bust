{% include "vhdl/testbench/localbus_tb/monitor_signals.j2" %}

begin

  clock_generator(clk, C_CLK_PERIOD);

  dut : entity work.{{ module.name }}_{{ module.bus.endpoint_suffix }}(rtl)
    generic map (
      G_BASE_ADDRESS       => unsigned(C_BASE),
      G_CHECK_BASE_ADDRESS => true,
      G_MODULE_ADDR_WIDTH  => {{ tb.module_addr_width }},
      G_UNMAPPED_READ_DATA => C_UNMAPPED_READ_DATA,
      G_ERR_ON_BAD_ACCESS  => true
    )
    port map (
{% filter align("=>") %}
      clk_i => clk,
      rst_i => reset,
      cyc_i => wb_cyc,
      stb_i => wb_stb,
      we_i => wb_we,
      adr_i => wb_adr,
      dat_i => wb_dat_w,
      dat_o => wb_dat_r,
      ack_o => wb_ack,
      err_o => wb_err{{ "," if module.to_hw_registers or module.from_hw_registers else "" }}
{% if module.to_hw_registers %}
      to_hw => to_hw{{ "," if module.from_hw_registers else "" }}
{% endif %}
{% if module.from_hw_registers %}
      from_hw => from_hw
{% endif %}
{% endfilter %}
    );
{% include "vhdl/testbench/localbus_tb/monitor_process.j2" %}

  p_main : process is

    -- Classic Wishbone single write: assert cyc/stb/we, hold until ack/err.
    procedure bus_write (
      constant addr       : in unsigned;
      constant data       : in std_logic_vector;
      constant msg        : in string;
      constant expect_err : in boolean := false
    ) is
    begin

      wb_cyc   <= '1';
      wb_stb   <= '1';
      wb_we    <= '1';
      wb_adr   <= std_logic_vector(addr);
      wb_dat_w <= data;
      wait until rising_edge(clk);

      while (wb_ack = '0' and wb_err = '0') loop

        wait until rising_edge(clk);

      end loop;

      if (expect_err) then
        check_value(wb_err, '1', error, "write must terminate on err: " & msg, C_SCOPE);
      else
        check_value(wb_err, '0', error, "write must terminate on ack, not err: " & msg, C_SCOPE);
      end if;

      wb_cyc   <= '0';
      wb_stb   <= '0';
      wb_we    <= '0';
      wb_adr   <= (others => '0');
      wb_dat_w <= (others => '0');
      wait for 0 ns;

    end procedure bus_write;

    -- Classic Wishbone single read: drive the qualified cycle, hold until the
    -- regfile answers, then return the read data and the err_o termination flag.
    procedure bus_read (
      constant addr    : in unsigned;
      variable data    : out std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable got_err : out boolean
    ) is
    begin

      wb_cyc <= '1';
      wb_stb <= '1';
      wb_we  <= '0';
      wb_adr <= std_logic_vector(addr);
      wait until rising_edge(clk);

      while (wb_ack = '0' and wb_err = '0') loop

        wait until rising_edge(clk);

      end loop;

      data    := wb_dat_r;
      got_err := wb_err = '1';
      wb_cyc  <= '0';
      wb_stb  <= '0';
      wb_adr  <= (others => '0');
      wait for 0 ns;

    end procedure bus_read;

    procedure bus_check (
      constant addr : in unsigned;
      constant data : in std_logic_vector;
      constant msg  : in string
    ) is

      variable v_data    : std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable v_got_err : boolean;

    begin

      bus_read(addr, v_data, v_got_err);
      check_value(v_got_err, false, error, msg & " (terminated on ack)", C_SCOPE);
      check_value(v_data, data, error, msg, C_SCOPE);

    end procedure bus_check;

    -- An address without a register terminates on err.
    procedure bus_write_unmapped (
      constant addr : in unsigned;
      constant data : in std_logic_vector;
      constant msg  : in string
    ) is
    begin

      bus_write(addr, data, msg, expect_err => true);

    end procedure bus_write_unmapped;

    procedure bus_check_unmapped (
      constant addr : in unsigned;
      constant msg  : in string
    ) is

      variable v_data    : std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable v_got_err : boolean;

    begin

      bus_read(addr, v_data, v_got_err);
      check_value(v_got_err, true, error, msg & " (terminated on err)", C_SCOPE);
      check_value(v_data, C_UNMAPPED_READ_DATA, error, msg, C_SCOPE);

    end procedure bus_check_unmapped;
{% include "vhdl/testbench/localbus_tb/snapshot_vars.j2" %}

  begin

    disable_log_msg(ALL_MESSAGES, QUIET);
    enable_log_msg(ID_LOG_HDR, QUIET);

    gen_pulse(reset, '1', 500 ns, BLOCKING, "Reset for 500 ns");
{% include "vhdl/testbench/localbus_tb/test_sequence.j2" %}

    wait for 10 * C_CLK_PERIOD;
    report_alert_counters(FINAL);
    log(ID_LOG_HDR, "SIMULATION COMPLETED", C_SCOPE);
    std.env.stop;
    wait;

  end process p_main;

end architecture tb;
