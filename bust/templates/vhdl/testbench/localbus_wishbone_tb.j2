  signal wb_stb : std_logic := '0';
  signal wb_we : std_logic := '0';
  signal wb_adr : std_logic_vector({{ module.addr_width - 1 }} downto 0) := (others => '0');
  signal wb_dat_w : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal wb_dat_r : std_logic_vector({{ module.data_width - 1 }} downto 0);
  signal wb_ack : std_logic;
  signal wb_err : std_logic;
{% endfilter %}

  function f_addr (
    reg : std_logic_vector({{ module.addr_width - 1 }} downto 0)
  ) return unsigned is
  begin

    return unsigned(C_BASE) + unsigned(reg);

