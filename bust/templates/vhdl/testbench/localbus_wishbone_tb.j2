-- Generated testbench for the {{ module.name }} module (Wishbone B4 classic).
-- UVVM ships no Wishbone VIP, so this drives the {{ module.name }} top entity with
-- an inlined hand-written classic-cycle Wishbone master BFM (the bus_write/bus_read
-- procedures below) and uses uvvm_util only for logging and checks. It self-checks
-- every register whose behaviour the prototype exercises: plain read-write,
-- enumerated, write-only/singlepulse (reads back 0), onread/onwrite software side
-- effects, software-readonly registers driven from from_hw (we/wel), the hardware
-- we override / hwset / hwclr modifiers, the to_hw values the hardware sees, and the
-- swmod/swacc/singlepulse to_hw strobe pulses (counted by a monitor process, since
-- they are single-cycle).
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library uvvm_util;
context uvvm_util.uvvm_util_context;

use work.localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_tb is
end entity {{ module.name }}_tb;

architecture tb of {{ module.name }}_tb is

  constant C_SCOPE      : string := C_TB_SCOPE_DEFAULT;
  constant C_CLK_PERIOD : time   := 10 ns;

  constant C_BASE : std_logic_vector({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";

  signal clk   : std_logic := '0';
  signal reset : std_logic := '0';   -- active-high; gen_pulse asserts it
{% include "vhdl/testbench/localbus_tb/hw_signals.j2" %}

  signal wb_cyc   : std_logic := '0';
  signal wb_stb   : std_logic := '0';
  signal wb_we    : std_logic := '0';
  signal wb_adr   : std_logic_vector({{ module.addr_width - 1 }} downto 0) := (others => '0');
  signal wb_dat_w : std_logic_vector({{ module.data_width - 1 }} downto 0) := (others => '0');
  signal wb_dat_r : std_logic_vector({{ module.data_width - 1 }} downto 0);
  signal wb_ack   : std_logic;
  signal wb_err   : std_logic;

  function f_addr(reg : std_logic_vector({{ module.addr_width - 1 }} downto 0)) return unsigned is
  begin
    return unsigned(C_BASE) + unsigned(reg);
  end function;
{% include "vhdl/testbench/localbus_tb/monitor_signals.j2" %}

begin

  clock_generator(clk, C_CLK_PERIOD);

  DUT : entity work.{{ module.name }}
    generic map (
      G_BASE_ADDRESS       => unsigned(C_BASE),
      G_CHECK_BASE_ADDRESS => true)
    port map (
      clk_i   => clk,
      rst_i   => reset,
      cyc_i   => wb_cyc,
      stb_i   => wb_stb,
      we_i    => wb_we,
      adr_i   => wb_adr,
      dat_i   => wb_dat_w,
      dat_o   => wb_dat_r,
      ack_o   => wb_ack,
      err_o   => wb_err{% if module.to_hw_registers or module.from_hw_registers %},{% endif %}
{% if module.to_hw_registers %}
      to_hw   => to_hw{% if module.from_hw_registers %},{% endif %}
{% endif %}
{% if module.from_hw_registers %}
      from_hw => from_hw{% endif %});
{% include "vhdl/testbench/localbus_tb/monitor_process.j2" %}

  p_main : process is

    -- Classic Wishbone single write: assert cyc/stb/we, hold until ack/err.
    procedure bus_write(constant addr : in unsigned;
                        constant data : in std_logic_vector;
                        constant msg  : in string) is
    begin
      wb_cyc   <= '1';
      wb_stb   <= '1';
      wb_we    <= '1';
      wb_adr   <= std_logic_vector(addr);
      wb_dat_w <= data;
      wait until rising_edge(clk);
      while wb_ack = '0' and wb_err = '0' loop
        wait until rising_edge(clk);
      end loop;
      wb_cyc   <= '0';
      wb_stb   <= '0';
      wb_we    <= '0';
      wb_adr   <= (others => '0');
      wb_dat_w <= (others => '0');
      wait for 0 ns;
    end procedure;

    -- Classic Wishbone single read: drive the qualified cycle, hold until the
    -- regfile answers, then return the read data and the err_o termination flag.
    procedure bus_read(constant addr    : in  unsigned;
                       variable data    : out std_logic_vector({{ module.data_width - 1 }} downto 0);
                       variable got_err : out boolean) is
    begin
      wb_cyc <= '1';
      wb_stb <= '1';
      wb_we  <= '0';
      wb_adr <= std_logic_vector(addr);
      wait until rising_edge(clk);
      while wb_ack = '0' and wb_err = '0' loop
        wait until rising_edge(clk);
      end loop;
      data    := wb_dat_r;
      got_err := wb_err = '1';
      wb_cyc  <= '0';
      wb_stb  <= '0';
      wb_adr  <= (others => '0');
      wait for 0 ns;
    end procedure;

    procedure bus_check(constant addr : in unsigned;
                        constant data : in std_logic_vector;
                        constant msg  : in string) is
      variable v_data    : std_logic_vector({{ module.data_width - 1 }} downto 0);
      variable v_got_err : boolean;
    begin
      bus_read(addr, v_data, v_got_err);
      check_value(v_got_err, false, error, msg & " (terminated on ack)", C_SCOPE);
      check_value(v_data, data, error, msg, C_SCOPE);
    end procedure;
{% include "vhdl/testbench/localbus_tb/snapshot_vars.j2" %}

  begin
    disable_log_msg(ALL_MESSAGES, QUIET);
    enable_log_msg(ID_LOG_HDR, QUIET);

    gen_pulse(reset, '1', 500 ns, BLOCKING, "Reset for 500 ns");
{% include "vhdl/testbench/localbus_tb/test_sequence.j2" %}

    wait for 10*C_CLK_PERIOD;
    report_alert_counters(FINAL);
    log(ID_LOG_HDR, "SIMULATION COMPLETED", C_SCOPE);
    std.env.stop;
    wait;
  end process p_main;

end architecture tb;
