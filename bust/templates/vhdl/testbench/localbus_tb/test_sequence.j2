{# Shared local-bus testbench body. Bus-neutral: drives the register-map through
   bus_write/bus_check(f_addr(offset), ...), defined per bus shell. #}
{% filter wrap %}
{% filter align("<=|:=") %}
{% for reg in module.registers if reg.is_simple_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: software read-write round-trip", C_SCOPE);
    bus_write(f_addr({{ reg.offset_constant }}), {{ reg.selftest_value_vhdl }}, "write {{ reg.name }}");
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.selftest_value_vhdl }}, "{{ reg.name }} reads back");
{% for f in reg.to_hw_fields %}
    check_value(to_hw.{{ f.hw_path }}{{ ".value" if f.to_hw_is_record else "" }}, {{ f.all_ones_literal }}, error, "{{ reg.name }}.{{ f.name }} exposed to hw", C_SCOPE);
{% endfor %}
{% endfor %}
{% for reg in module.registers if reg.is_enum_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: enumerated round-trip", C_SCOPE);
    bus_write(f_addr({{ reg.offset_constant }}), {{ reg.enum_selftest_value_vhdl }}, "write {{ reg.name }}");
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.enum_selftest_value_vhdl }}, "{{ reg.name }} reads back encoded value");
{% endfor %}
{% for reg in module.registers if reg.reads_back_zero %}

    log(ID_LOG_HDR, "{{ reg.name }}: write-only / pulse reads back zero", C_SCOPE);
    bus_write(f_addr({{ reg.offset_constant }}), {{ reg.selftest_value_vhdl }}, "write {{ reg.name }}");
{% if reg.sw_readable %}
    bus_check(f_addr({{ reg.offset_constant }}), {{ module.data_width }}x"0", "{{ reg.name }} reads back zero");
{% else %}
    bus_check_unmapped(f_addr({{ reg.offset_constant }}), "read {{ reg.name }}, which software cannot read");
{% endif %}
{% endfor %}
{% for reg in module.registers if reg.is_onwrite_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: onwrite software side effects", C_SCOPE);
    bus_write(f_addr({{ reg.offset_constant }}), {{ reg.onwrite_write_value_vhdl }}, "write {{ reg.name }}");
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.onwrite_expected_value_vhdl }}, "{{ reg.name }} applies onwrite effects");
{% endfor %}
{% for reg in module.registers if reg.is_onread_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: onread software side effects", C_SCOPE);
    bus_write(f_addr({{ reg.offset_constant }}), {{ reg.onread_write_value_vhdl }}, "write {{ reg.name }}");
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.onread_write_value_vhdl }}, "{{ reg.name }} first read returns stored value");
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.onread_post_read_value_vhdl }}, "{{ reg.name }} second read reflects onread");
{% endfor %}
{% for reg in module.registers if reg.is_hw_driven_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: hardware-driven status read back over the bus", C_SCOPE);
    wait until falling_edge(clk);
{% for s in reg.hw_drive_steps %}
    from_hw.{{ s.path }}{{ ("." ~ s.member) if s.member else "" }} <= {{ s.literal }};
{% if s.enable == 'we' %}
    from_hw.{{ s.path }}.we <= '1';
{% elif s.enable == 'wel' %}
    from_hw.{{ s.path }}.wel <= '0';
{% endif %}
{% endfor %}
    wait until falling_edge(clk);
{% for s in reg.hw_drive_steps if s.enable %}
{% if s.enable == 'we' %}
    from_hw.{{ s.path }}.we <= '0';
{% else %}
    from_hw.{{ s.path }}.wel <= '1';
{% endif %}
{% endfor %}
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.hw_driven_expected_value_vhdl }}, "{{ reg.name }} reflects hardware inputs");
{% endfor %}
{% for reg in module.registers if reg.is_hw_modify_register %}
{% for step in reg.hw_modify_steps %}

    log(ID_LOG_HDR, "{{ step.log }}", C_SCOPE);
{% if step.sw_write %}
    bus_write(f_addr({{ reg.offset_constant }}), {{ step.sw_write }}, "write {{ reg.name }}");
{% endif %}
{% if step.drives or step.strobes %}
    wait until falling_edge(clk);
{% for d in step.drives %}
    from_hw.{{ d.target }} <= {{ d.literal }};
{% endfor %}
{% for s in step.strobes %}
    from_hw.{{ s.target }} <= {{ s.on }};
{% endfor %}
    wait until falling_edge(clk);
{% for s in step.strobes %}
    from_hw.{{ s.target }} <= {{ s.off }};
{% endfor %}
{% endif %}
    bus_check(f_addr({{ reg.offset_constant }}), {{ step.expected }}, "{{ step.expected_msg }}");
{% for c in step.to_hw_checks %}
    check_value(to_hw.{{ c.target }}, {{ c.literal }}, error, "{{ reg.name }}.{{ c.name }} exposed to hw", C_SCOPE);
{% endfor %}
{% endfor %}
{% endfor %}
{% for reg in module.strobe_registers %}

    log(ID_LOG_HDR, "{{ reg.name }}: software-access strobe pulses", C_SCOPE);
{% for f in reg.swmod_fields %}
    v_{{ reg.name }}_{{ f.name }}_swmod := {{ reg.name }}_{{ f.name }}_swmod_count;
{% endfor %}
{% for f in reg.swacc_fields %}
    v_{{ reg.name }}_{{ f.name }}_swacc := {{ reg.name }}_{{ f.name }}_swacc_count;
{% endfor %}
{% for f in reg.singlepulse_fields %}
    v_{{ reg.name }}_{{ f.name }}_sp := {{ reg.name }}_{{ f.name }}_sp_count;
{% endfor %}
{% if reg.sw_writable %}
    bus_write(f_addr({{ reg.offset_constant }}), {{ reg.strobe_write_value_vhdl }}, "write {{ reg.name }}");
{% else %}
    bus_write_unmapped(f_addr({{ reg.offset_constant }}), {{ reg.strobe_write_value_vhdl }}, "write {{ reg.name }}, which software cannot write");
{% endif %}
{% if reg.swacc_fields and reg.sw_readable %}
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.strobe_readback_value_vhdl }}, "read {{ reg.name }}");
{% elif reg.swacc_fields %}
    bus_check_unmapped(f_addr({{ reg.offset_constant }}), "read {{ reg.name }}, which software cannot read");
{% endif %}
    wait until rising_edge(clk);
    wait until rising_edge(clk);
{% for f in reg.swmod_fields %}
    check_value({{ reg.name }}_{{ f.name }}_swmod_count - v_{{ reg.name }}_{{ f.name }}_swmod, 1, error, "{{ reg.name }}.{{ f.name }} swmod pulses once per write", C_SCOPE);
{% endfor %}
{% for f in reg.swacc_fields %}
    check_value({{ reg.name }}_{{ f.name }}_swacc_count - v_{{ reg.name }}_{{ f.name }}_swacc, 2, error, "{{ reg.name }}.{{ f.name }} swacc pulses per access (write + read)", C_SCOPE);
{% endfor %}
{% for f in reg.singlepulse_fields %}
    check_value({{ reg.name }}_{{ f.name }}_sp_count - v_{{ reg.name }}_{{ f.name }}_sp, 1, error, "{{ reg.name }}.{{ f.name }} singlepulse lasts exactly one cycle", C_SCOPE);
    check_value({{ reg.name }}_{{ f.name }}_sp_value, {{ f.value_literal(f.pulse_test_value) }}, error, "{{ reg.name }}.{{ f.name }} hw saw the pulse value", C_SCOPE);
{% endfor %}
{% endfor %}
{% for reg in module.registers if reg.is_hwset_read_clear_register %}
{% set f = reg.effective_fields[0] %}

    -- hwset is held through the read, so it meets the read clear in the same
    -- cycle. The value sampled with the swacc strobe shows which one won.
    log(ID_LOG_HDR, "{{ reg.name }}: hwset beats a read clear in the same cycle", C_SCOPE);
    wait until falling_edge(clk);
    from_hw.{{ f.hw_path }}.set <= '1';
    wait until falling_edge(clk);
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.selftest_value_vhdl }}, "{{ reg.name }} read while hwset is held");
    wait until falling_edge(clk);
    from_hw.{{ f.hw_path }}.set <= '0';
    check_value({{ reg.name }}_{{ f.name }}_at_swacc, {{ f.all_ones_literal }}, error, "{{ reg.name }}.{{ f.name }} still set in the cycle after the read clear", C_SCOPE);
    bus_check(f_addr({{ reg.offset_constant }}), {{ reg.selftest_value_vhdl }}, "{{ reg.name }} still set after that read");
    bus_check(f_addr({{ reg.offset_constant }}), {{ module.data_width }}x"0", "{{ reg.name }} cleared by a read without hwset");
{% endfor %}
{% set read_only = module.registers | rejectattr('sw_writable') | list %}
{% set write_only = module.registers | rejectattr('sw_readable') | list %}
{% if read_only or write_only %}

    -- With G_ERR_ON_BAD_ACCESS, a write to a register software cannot write and
    -- a read of one it cannot read get an error response where the bus has one.
    log(ID_LOG_HDR, "accesses in the wrong direction get an error", C_SCOPE);
{% for reg in read_only %}
    bus_write_unmapped(f_addr({{ reg.offset_constant }}), {{ module.data_width }}x"0", "write {{ reg.name }}, which software cannot write");
{% endfor %}
{% for reg in write_only %}
    bus_check_unmapped(f_addr({{ reg.offset_constant }}), "read {{ reg.name }}, which software cannot read");
{% endfor %}
{% endif %}
{% if tb.unmapped_addresses %}
{% set alias = tb.alias_register %}

    -- An address where no register sits gets an error response where the bus
    -- has one, reads as G_UNMAPPED_READ_DATA, and a write to it changes no register.
    log(ID_LOG_HDR, "addresses without a register get an error and change nothing", C_SCOPE);
{% for u in tb.unmapped_addresses %}
    bus_write_unmapped(f_addr({{ u.literal }}), {{ module.data_width }}x"0", "write {{ u.hex }}, {{ u.why }}");
    bus_check_unmapped(f_addr({{ u.literal }}), "read {{ u.hex }}, {{ u.why }}");
{% endfor %}
{% if alias %}
    bus_check(f_addr({{ alias.offset_constant }}), {{ alias.selftest_value_vhdl }}, "{{ alias.name }} unchanged by the unmapped writes");
{% endif %}
{% endif %}
{% endfilter %}
{% endfilter %}
