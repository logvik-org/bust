{% from "vhdl/aggregate.j2" import reset_entry %}
{# An enum has no all-zeros literal, so its idle input is the reset literal. #}
{% macro fhw_default(m, f) -%}
{%- if m == 'value' -%}{{ f.reset_value_vhdl if f.is_enum else f.zeros_literal }}{%- elif m == 'wel' -%}'1'{%- else -%}'0'{%- endif -%}
{%- endmacro -%}
{% macro fhw_idle(f) -%}
{%- if f.from_hw_is_record -%}({% for m in f.from_hw_members %}{{ m }} => {{ fhw_default(m, f) }}{% if not loop.last %}, {% endif %}{% endfor %}){%- else -%}{{ fhw_default('value', f) }}{%- endif -%}
{%- endmacro -%}
{% set unmapped = ("DEADBEEF" * (module.data_width // 32 + 1))[:module.data_width // 4] %}

  -- What a read gets where no register sits (G_UNMAPPED_READ_DATA).
  constant C_UNMAPPED_READ_DATA : std_logic_vector({{ module.data_width - 1 }} downto 0) := {{ module.data_width }}x"{{ unmapped }}";
{% if module.from_hw_registers %}

  -- from_hw at rest: every strobe inactive and every value 0, or the reset
  -- literal for an enumerated field.
{% filter align("=>", nested=true) %}
  constant C_FROM_HW_IDLE : t_{{ module.name }}_from_hw :=
  (
{% for reg in module.from_hw_registers %}
{% set items = [] %}
{% for f in reg.from_hw_fields %}{% set _ = items.append((f.name ~ " => " if reg.fields else "") ~ fhw_idle(f)) %}{% endfor %}
{{ reset_entry(reg.name, items, not reg.fields, loop.last) }}
{%- endfor %}
  );
{% endfilter %}
{% endif %}
{% if module.to_hw_registers or module.from_hw_registers %}

{% endif %}
{% filter align(":") %}
{% if module.to_hw_registers %}
  signal to_hw : t_{{ module.name }}_to_hw;
{% endif %}
{% if module.from_hw_registers %}
  signal from_hw : t_{{ module.name }}_from_hw := C_FROM_HW_IDLE;
{% endif %}
{% endfilter %}
