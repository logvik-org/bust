{% macro fhw_default(m, f) -%}
{%- if m == 'value' -%}{{ f.zeros_literal }}{%- elif m == 'wel' -%}'1'{%- else -%}'0'{%- endif -%}
{%- endmacro -%}
-- Generated UVVM testbench for the {{ module.name }} module (AXI4-Lite).
-- Drives the {{ module.name }} top entity with the stock Bitvis AXI-Lite VIP and
-- self-checks every register whose readback is predictable: plain read-write,
-- enumerated, write-only/singlepulse (reads back 0), onread/onwrite software
-- side effects, and software-readonly registers driven entirely from from_hw
-- (we/wel value inputs). It also checks the to_hw values the hardware sees on
-- plain read-write registers. Not checked here yet: the hwset/hwclr from_hw
-- inputs and the swmod/swacc to_hw strobe outputs.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library uvvm_util;
context uvvm_util.uvvm_util_context;

library bitvis_vip_axilite;
use bitvis_vip_axilite.axilite_bfm_pkg.all;

use work.localbus_pkg.all;
use work.{{ module.name }}_regfile_pkg.all;

entity {{ module.name }}_tb is
end entity {{ module.name }}_tb;

architecture tb of {{ module.name }}_tb is

  constant C_SCOPE      : string := C_TB_SCOPE_DEFAULT;
  constant C_CLK_PERIOD : time   := 10 ns;

  constant C_BASE : std_logic_vector({{ module.addr_width - 1 }} downto 0) := {{ module.addr_width }}x"0";

  signal clk      : std_logic := '0';
  signal areset_n : std_logic := '1';
{% if module.to_hw_registers %}

  signal to_hw    : t_{{ module.name }}_to_hw;
{% endif %}
{% if module.from_hw_registers %}
  signal from_hw  : t_{{ module.name }}_from_hw := (
{% for reg in module.from_hw_registers %}
    {{ reg.name }} => ({% for f in reg.from_hw_fields %}{{ f.name }} => {% if f.from_hw_is_record %}({% for m in f.from_hw_members %}{{ m }} => {{ fhw_default(m, f) }}{% if not loop.last %}, {% endif %}{% endfor %}){% else %}{{ f.zeros_literal }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}){% if not loop.last %},{% else %});{% endif %}

{% endfor %}
{% endif %}

  constant C_DATA_W : natural := {{ module.data_width }};
  constant C_ADDR_W : natural := {{ module.addr_width }};
  signal axilite_if : t_axilite_if(write_address_channel(awaddr(C_ADDR_W-1 downto 0)),
                                   write_data_channel(wdata(C_DATA_W-1 downto 0),
                                                      wstrb((C_DATA_W/8)-1 downto 0)),
                                   read_address_channel(araddr(C_ADDR_W-1 downto 0)),
                                   read_data_channel(rdata(C_DATA_W-1 downto 0)))
                      := init_axilite_if_signals(C_DATA_W, C_ADDR_W);
  signal axilite_bfm_config : t_axilite_bfm_config := C_AXILITE_BFM_CONFIG_DEFAULT;

  function f_addr(base : std_logic_vector({{ module.addr_width - 1 }} downto 0);
                  reg  : std_logic_vector({{ module.addr_width - 1 }} downto 0)) return unsigned is
  begin
    return unsigned(base) + unsigned(reg);
  end function;

begin

  clock_generator(clk, C_CLK_PERIOD);

  DUT : entity work.{{ module.name }}
    generic map (
      G_BASE_ADDRESS       => unsigned(C_BASE),
      G_CHECK_BASE_ADDRESS => true)
    port map (
      clk      => clk,
      areset_n => areset_n,
      awaddr   => axilite_if.write_address_channel.awaddr,
      awvalid  => axilite_if.write_address_channel.awvalid,
      awready  => axilite_if.write_address_channel.awready,
      wdata    => axilite_if.write_data_channel.wdata,
      wvalid   => axilite_if.write_data_channel.wvalid,
      wready   => axilite_if.write_data_channel.wready,
      bresp    => axilite_if.write_response_channel.bresp,
      bvalid   => axilite_if.write_response_channel.bvalid,
      bready   => axilite_if.write_response_channel.bready,
      araddr   => axilite_if.read_address_channel.araddr,
      arvalid  => axilite_if.read_address_channel.arvalid,
      arready  => axilite_if.read_address_channel.arready,
      rdata    => axilite_if.read_data_channel.rdata,
      rresp    => axilite_if.read_data_channel.rresp,
      rvalid   => axilite_if.read_data_channel.rvalid,
      rready   => axilite_if.read_data_channel.rready{% if module.to_hw_registers or module.from_hw_registers %},{% endif %}
{% if module.to_hw_registers %}
      to_hw    => to_hw{% if module.from_hw_registers %},{% endif %}
{% endif %}
{% if module.from_hw_registers %}
      from_hw  => from_hw{% endif %});

  p_main : process is

    procedure axi_write(constant addr : in unsigned;
                        constant data : in std_logic_vector;
                        constant msg  : in string) is
    begin
      axilite_write(addr, data, msg, clk, axilite_if, C_SCOPE,
                    shared_msg_id_panel, axilite_bfm_config);
    end procedure;

    procedure axi_check(constant addr : in unsigned;
                        constant data : in std_logic_vector;
                        constant msg  : in string) is
    begin
      axilite_check(addr, data, msg, clk, axilite_if, error, C_SCOPE,
                    shared_msg_id_panel, axilite_bfm_config);
    end procedure;

  begin
    axilite_bfm_config.clock_period <= C_CLK_PERIOD;

    disable_log_msg(ALL_MESSAGES, QUIET);
    enable_log_msg(ID_LOG_HDR, QUIET);

    gen_pulse(areset_n, '0', 500 ns, BLOCKING, "Reset for 500 ns");
{% for reg in module.registers if reg.is_simple_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: software read-write round-trip", C_SCOPE);
    axi_write(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.selftest_value_vhdl }}, "write {{ reg.name }}");
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.selftest_value_vhdl }}, "{{ reg.name }} reads back");
{% for f in reg.to_hw_fields %}
    check_value(to_hw.{{ reg.name }}.{{ f.name }}{{ ".value" if f.to_hw_is_record else "" }}, {{ f.all_ones_literal }}, error, "{{ reg.name }}.{{ f.name }} exposed to hw", C_SCOPE);
{% endfor %}
{% endfor %}
{% for reg in module.registers if reg.is_enum_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: enumerated round-trip", C_SCOPE);
    axi_write(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.enum_selftest_value_vhdl }}, "write {{ reg.name }}");
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.enum_selftest_value_vhdl }}, "{{ reg.name }} reads back encoded value");
{% endfor %}
{% for reg in module.registers if reg.reads_back_zero %}

    log(ID_LOG_HDR, "{{ reg.name }}: write-only / pulse reads back zero", C_SCOPE);
    axi_write(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.selftest_value_vhdl }}, "write {{ reg.name }}");
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ module.data_width }}x"0", "{{ reg.name }} reads back zero");
{% endfor %}
{% for reg in module.registers if reg.is_onwrite_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: onwrite software side effects", C_SCOPE);
    axi_write(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.onwrite_write_value_vhdl }}, "write {{ reg.name }}");
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.onwrite_expected_value_vhdl }}, "{{ reg.name }} applies onwrite effects");
{% endfor %}
{% for reg in module.registers if reg.is_onread_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: onread software side effects", C_SCOPE);
    axi_write(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.onread_write_value_vhdl }}, "write {{ reg.name }}");
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.onread_write_value_vhdl }}, "{{ reg.name }} first read returns stored value");
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.onread_post_read_value_vhdl }}, "{{ reg.name }} second read reflects onread");
{% endfor %}
{% for reg in module.registers if reg.is_hw_driven_readback %}

    log(ID_LOG_HDR, "{{ reg.name }}: hardware-driven status read back over the bus", C_SCOPE);
    wait until falling_edge(clk);
{% for s in reg.hw_drive_steps %}
    from_hw.{{ reg.name }}.{{ s.field }}{{ ("." ~ s.member) if s.member else "" }} <= {{ s.literal }};
{% if s.enable == 'we' %}
    from_hw.{{ reg.name }}.{{ s.field }}.we <= '1';
{% elif s.enable == 'wel' %}
    from_hw.{{ reg.name }}.{{ s.field }}.wel <= '0';
{% endif %}
{% endfor %}
    wait until falling_edge(clk);
{% for s in reg.hw_drive_steps if s.enable %}
{% if s.enable == 'we' %}
    from_hw.{{ reg.name }}.{{ s.field }}.we <= '0';
{% else %}
    from_hw.{{ reg.name }}.{{ s.field }}.wel <= '1';
{% endif %}
{% endfor %}
    axi_check(f_addr(C_BASE, C_ADDR_{{ reg.name | upper }}), {{ reg.hw_driven_expected_value_vhdl }}, "{{ reg.name }} reflects hardware inputs");
{% endfor %}

    wait for 10*C_CLK_PERIOD;
    report_alert_counters(FINAL);
    log(ID_LOG_HDR, "SIMULATION COMPLETED", C_SCOPE);
    std.env.stop;
    wait;
  end process p_main;

end architecture tb;
