{
  "name": "bust-editor",
  "version": "0.1.0",
  "description": "Register map editor for bust, the VHDL register file generator",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logvik-org/bust.git",
    "directory": "editor-ui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && cp src/style.css dist/",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "happy-dom": "21.0.3",
    "typescript": "5.9.3"
  }
}
